---
// The site header: the NEON island, fixed and centred, always visible, and the full screen menu it opens
// (decisions M1 to M4, the owner's BitcoinOS "full-screen menu with art panel" pick).
//   Desktop (1280 and up): the menu is one surface that grows out of the island to fill the window. Left, a tall
//   art panel with cut corners; hovering or focusing a link crossfades it to that link's picture (official cover
//   art per game, the GTA VI wallpapers and our own coast drawing for the main links). Middle, the search, the
//   numbered heavy caps links under bracket labels, the small utility links, the chapter setting and the theme.
//   Right, the Games list (decisions GS1 to GS6): official logo plate, name, connection count, by group.
//   Phone and tablet: the same surface as a full screen sheet; the art panel is a short banner that follows the
//   item last focused or touched, the sections stack below and scroll.
// The menu button turns into the close cross; Escape closes; focus stays inside the header while it is open and
// returns to the menu button. The page behind is inert.
// Optional sub bar (NEON "GET TICKETS" row): pass `sub` from a page with a hero; desktop only.
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import GamePlate from '../games/GamePlate.astro';
import ChapterControl from '../ChapterControl.astro';
import { nav, isCurrent } from '../../lib/nav';
import { switcherGroups, connectionCount, games as allGames, TRADEMARK_LINE } from '../../lib/games';
import { gameArt, linkArt, type MenuArt } from '../../lib/menu';
import { byNewest } from '../../lib/feed';
import { categoryLabel, regionLabel } from '../../lib/media';
import { submitFindLink } from '../../lib/issues';
/** openTab: on a find page, the tab the bar opens in place (the page's [data-open-tab] handler); href still works without JavaScript. */
export interface SubBar { href: string; label: string; image?: string | null; openTab?: string }
interface Props { sub?: SubBar }
const { sub } = Astro.props;
const path = Astro.url.pathname;
// Switcher order, then the games outside it: a move between hubs slides the way this list runs (site-motion.ts).
const switcherIds = switcherGroups.flatMap((g) => g.games.map((x) => x.id));
const gameOrder = [...switcherIds, ...allGames.map((g) => g.id).filter((id) => !switcherIds.includes(id))];

// One picture per link that has art; the panel starts on the current page's picture.
const arts: MenuArt[] = [
  ...nav.map((n) => linkArt(n.href)),
  ...switcherGroups.flatMap((gr) => gr.games.map(gameArt)),
].filter((a): a is MenuArt => a !== null);
const artKeys = new Set(arts.map((a) => a.key));
const currentGame = switcherIds.find((id) => isCurrent(path, `/gtaverse/games/${id}`));
const currentLink = nav.find((n) => n.href !== '/' && isCurrent(path, n.href))?.href ?? '/';
const startKey = [currentGame, currentLink, '/'].find((k) => k && artKeys.has(k)) ?? '';
const start = arts.find((a) => a.key === startKey);
const SIZES = '(max-width: 1279px) calc(100vw - 32px), 30vw';

// Story spoilers and mature finds never appear in previews (feed.ts), so the latest three skip them.
const latest = byNewest.filter((f) => !f.spoiler && !f.mature).slice(0, 3);
const utility = [
  { href: '/about', label: 'About' },
  { href: '/finders', label: 'Finders' },
  { href: '/data', label: 'Data' },
  { href: submitFindLink(), label: 'Submit a find', external: true },
];
// The links arrive one after another once the art has settled; each gap a little shorter (choreography).
const delays = [0, 40, 75, 105, 130];
const pad = (n: number) => String(n).padStart(2, '0');
---
<header class="site-header" data-header data-game-order={JSON.stringify(gameOrder)}>
  <div class="menu" id="site-menu" data-menu hidden data-art-start={startKey}>
    <div class="menu__inner" data-menu-inner>
      <div class="menu__art">
        <div class="menu__frame" data-art-frame>
          <div class="menu__glow" aria-hidden="true"></div>
          {arts.map((a) => (
            <picture class="menu__pic" data-art={a.key} data-caption={a.caption} data-credit={a.credit} style={`--pos: ${a.position}; --pos-phone: ${a.phonePosition}`}>
              {a.sources.map((s) => <source type={s.type} media={s.media} data-srcset={s.srcset} sizes={SIZES} />)}
              <img alt="" data-src={a.src} decoding="async" draggable="false" />
            </picture>
          ))}
        </div>
        <p class="menu__caption" aria-hidden="true">
          <span class="menu__caption-text" data-art-caption>{start?.caption ?? 'The Vice Files'}</span>
          <span class="menu__credit" data-art-credit>{start?.credit ?? ''}</span>
        </p>
      </div>

      <form class="menu__search menu__fade" action="/map" method="get" role="search">
        <Icon name="search" size={20} class="menu__search-icon" />
        <input class="menu__search-input" type="search" name="q" placeholder="Search finds and places" aria-label="Search finds and places" autocomplete="off" enterkeyhint="search" maxlength="120" />
        <button class="menu__search-go" type="submit" aria-label="Search"><Icon name="arrow-right" size={18} /></button>
      </form>

      <nav class="menu__guide" aria-labelledby="menu-guide-label">
        <p class="menu__bracket menu__fade" id="menu-guide-label">[ The guide ]</p>
        <ol class="menu__links" role="list">
          {nav.map((item, i) => {
            const current = isCurrent(path, item.href);
            return (
              <li class="menu__item" style={`--d: ${delays[i] ?? 130}ms`}>
                <a class:list={['menu__link', { 'is-current': current }]} href={item.href} aria-current={current ? 'page' : undefined} data-art-key={item.href}>
                  <span class="menu__num tabular" aria-hidden="true">{pad(i + 1)}</span>
                  <Icon name={item.icon} size={24} solid={current} class="menu__icon" />
                  <span class="menu__label">{item.label}{item.count !== undefined && <sup class="menu__count tabular">({item.count})</sup>}</span>
                  <Icon name="arrow-right" size={20} class="menu__arrow" />
                </a>
              </li>
            );
          })}
        </ol>
      </nav>

      <section class="menu__latest menu__fade" aria-labelledby="menu-latest-label">
        <p class="menu__bracket" id="menu-latest-label">[ Latest finds ]</p>
        <ul class="menu__finds" role="list">
          {latest.map((f) => (
            <li>
              <a class="menu__find" href={`/finds/${f.slug}`} data-art-key="/finds">
                <span class="menu__find-title">{f.title}</span>
                <span class="menu__find-meta">{categoryLabel(f)}, {regionLabel(f)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="games menu__fade" id="games-switcher" aria-labelledby="games-title" data-games>
        <div class="games__head">
          <h2 class="menu__bracket games__title" id="games-title">[ Games ]</h2>
          <a class="games__all" href="/gtaverse/games">All games</a>
        </div>
        <div class="games__scroll" data-games-scroll>
          {switcherGroups.map((group) => (
            <div class="games__group">
              <p class="games__glabel" id={`games-g-${group.id}`}>{group.label}</p>
              <ul class="games__list" role="list" aria-labelledby={`games-g-${group.id}`}>
                {group.games.map((g) => {
                  const href = `/gtaverse/games/${g.id}`;
                  const current = isCurrent(path, href);
                  const n = connectionCount(g.id);
                  return (
                    <li>
                      <a class:list={['games__row', { 'is-current': current }]} href={href} aria-current={current ? 'page' : undefined} data-game-row data-art-key={g.id} title={g.name}>
                        <GamePlate game={g} size="rail" class="games__plate" />
                        <span class="games__name"><span class="games__label">{g.short_name}</span><sup class="games__count tabular">{n}<span class="sr-only"> {n === 1 ? 'connection' : 'connections'}</span></sup></span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
          <p class="games__tm">{TRADEMARK_LINE} Used only to identify each game. Cover art: Rockstar Games.</p>
        </div>
      </section>

      <div class="menu__foot menu__fade">
        <ul class="menu__util" role="list" aria-label="More">
          {utility.map((u) => (
            <li><a class="menu__util-link" href={u.href} rel={u.external ? 'noopener' : undefined}>{u.label}{u.external && <Icon name="arrow-up-right" size={14} />}</a></li>
          ))}
        </ul>
        <ChapterControl class="menu__chapter" />
      </div>

      <div class="menu__corner menu__fade">
        <button class="menu__theme" type="button" data-theme-toggle aria-label="Switch to light theme">
          <span class="theme-icon theme-icon--sun"><Icon name="sun" size={20} /></span>
          <span class="theme-icon theme-icon--moon"><Icon name="moon" size={20} /></span>
        </button>
      </div>
    </div>
  </div>

  <div class="island-wrap">
    <nav class="island" aria-label="Main">
      <button class="island__btn island__menu" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Menu" data-menu-open>
        <!-- The two lines meet and turn into a cross while the menu is open (drawn here so each line can move). -->
        <svg class="icon burger" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path class="burger__l burger__l1" d="M4 9.25h16" /><path class="burger__l burger__l2" d="M4 14.75h16" /></svg>
      </button>
      <a class="island__mark" href="/" aria-label="The Vice Files, home"><Logo height={18} class="island__logo" /></a>
      <div class="island__actions">
        <a class="island__btn" href="/map" aria-label="Map" aria-current={isCurrent(path, '/map') ? 'page' : undefined}>
          <Icon name="map" size={20} solid={isCurrent(path, '/map')} />
        </a>
        <button class="island__btn" type="button" data-theme-toggle aria-label="Switch to light theme">
          <span class="theme-icon theme-icon--sun"><Icon name="sun" size={20} /></span>
          <span class="theme-icon theme-icon--moon"><Icon name="moon" size={20} /></span>
        </button>
      </div>
    </nav>

    {sub && (
      <a class="subbar" href={sub.href} data-subbar data-open-tab={sub.openTab}>
        <span class="subbar__thumb" aria-hidden="true">{sub.image && <img src={sub.image} alt="" width="96" height="54" loading="eager" decoding="async" data-subbar-img />}</span>
        <span class="subbar__label" data-subbar-label>{sub.label}</span>
        <Icon name="arrow-right" size={16} class="subbar__arrow" />
      </a>
    )}
  </div>
</header>

<script>
  import { travellingPill } from '../../scripts/motion/pill';
  import { tokenMs } from '../../scripts/motion/tokens';
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const openBtn = header.querySelector<HTMLButtonElement>('[data-menu-open]')!;
    const menu = header.querySelector<HTMLElement>('[data-menu]')!;
    const inner = header.querySelector<HTMLElement>('[data-menu-inner]')!;
    const island = header.querySelector<HTMLElement>('.island')!;
    const frame = header.querySelector<HTMLElement>('[data-art-frame]')!;
    const caption = header.querySelector<HTMLElement>('[data-art-caption]')!;
    const credit = header.querySelector<HTMLElement>('[data-art-credit]')!;
    const desktop = matchMedia('(min-width: 1280px)');
    const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const css = getComputedStyle(document.documentElement);
    const ms = (name: string, fallback: number) => tokenMs(name, fallback);
    let closeTimer = 0;

    // ---------- Art panel. Pictures sit stacked; the new one fades in on top of the old, which stays fully visible
    // until the fade ends, so the glow behind never shows through (no flash). A picture only fades in once decoded.
    const pics = new Map([...frame.querySelectorAll<HTMLElement>('[data-art]')].map((p) => [p.dataset.art!, p]));
    let hydrated = false;
    const hydrate = (p: HTMLElement, priority: 'high' | 'low') => {
      const img = p.querySelector('img')!;
      if (img.getAttribute('src')) return;
      p.querySelectorAll<HTMLSourceElement>('source[data-srcset]').forEach((s) => { s.srcset = s.dataset.srcset!; });
      img.fetchPriority = priority;
      img.src = img.dataset.src!;
    };
    // Preload on open: the starting picture at once, every other one at low priority once the surface has grown
    // (so their decoding never lands on the opening frames). A picture asked for earlier loads on demand.
    const preload = (first?: HTMLElement) => {
      if (first) hydrate(first, 'high');
      if (hydrated) return;
      hydrated = true;
      window.setTimeout(() => pics.forEach((p) => hydrate(p, 'low')), ms('--dur-morph', 280) + 120);
    };
    let shown: HTMLElement | null = null;
    let want = '';
    let z = 1;
    const showText = (p: HTMLElement | null) => {
      caption.textContent = p?.dataset.caption ?? 'The Vice Files';
      credit.textContent = p?.dataset.credit ?? '';
    };
    const setArt = async (key: string, instant = false) => {
      if (key === want) return;
      want = key;
      const p = pics.get(key) ?? null;
      if (!p) return; // no art for this link: keep the current picture
      hydrate(p, 'high');
      const img = p.querySelector('img')!;
      if (!instant) {
        try { await img.decode(); } catch { /* not decodable yet: show it when it loads */ }
        if (want !== key) return; // a newer choice arrived while decoding
      }
      const prev = shown;
      shown = p;
      showText(p);
      p.style.zIndex = String(++z);
      p.classList.add('is-on');
      const done = () => { if (shown === p) pics.forEach((q) => { if (q !== p) q.classList.remove('is-on'); }); };
      if (instant || !prev || prev === p) { p.getAnimations().forEach((a) => a.cancel()); done(); return; }
      const fade = p.animate([{ opacity: 0 }, { opacity: 1 }], { duration: reduced() ? ms('--dur-fade-reduced', 150) : ms('--dur-image-in', 240), easing: css.getPropertyValue('--ease-colour').trim() || 'ease' });
      fade.finished.then(done, () => {});
    };
    const reset = () => {
      want = '';
      const start = pics.get(menu.dataset.artStart ?? '') ?? null;
      pics.forEach((q) => { q.classList.remove('is-on'); q.getAnimations().forEach((a) => a.cancel()); });
      shown = null;
      if (start) { preload(start); setArt(start.dataset.art!, true); } else { preload(); showText(null); }
    };

    // Hover asks for the art after a short pause so a fast sweep across the list does not flicker through every
    // picture; focus and touch ask at once.
    let hoverTimer = 0;
    inner.addEventListener('pointerover', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-art-key]');
      if (!el || e.pointerType !== 'mouse') return;
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => setArt(el.dataset.artKey!), 60);
    });
    inner.addEventListener('pointerout', () => window.clearTimeout(hoverTimer));
    inner.addEventListener('pointerdown', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-art-key]');
      if (el && e.pointerType !== 'mouse') setArt(el.dataset.artKey!);
    });
    inner.addEventListener('focusin', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-art-key]');
      if (el) setArt(el.dataset.artKey!);
    });

    // ---------- Open and close.
    // The surface grows out of the island (clip-path from the island's own rectangle to the window). The art fades
    // and settles, then the links rise one after another; the rest fades in with the last link. Closing, every word
    // fades at once and the surface folds back into the island, faster and on the exit curve. Keyboard opens and
    // closes never animate; reduced motion keeps only fades (the CSS holds the timings).
    const isOpen = () => openBtn.getAttribute('aria-expanded') === 'true';
    const outside = () => [...document.body.children].filter((el) => el !== header && !el.matches('script')) as HTMLElement[];
    const placeFrom = () => {
      const r = island.getBoundingClientRect();
      const t = Math.max(0, r.top), l = Math.max(0, r.left);
      const rr = Math.max(0, innerWidth - r.right), b = Math.max(0, innerHeight - r.bottom);
      menu.style.setProperty('--from', `inset(${t}px ${rr}px ${b}px ${l}px round var(--radius-xs))`);
    };
    const open = (instant = false) => {
      window.clearTimeout(closeTimer);
      placeFrom();
      menu.hidden = false;
      header.dataset.motion = instant ? 'none' : '';
      openBtn.setAttribute('aria-expanded', 'true');
      document.documentElement.classList.add('is-locked');
      outside().forEach((el) => { el.inert = true; });
      inner.scrollTop = 0;
      reset();
      menu.getBoundingClientRect(); // commit the closed state so the open state transitions from it
      header.dataset.menu = 'open';
    };
    const close = (instant = false, restoreFocus = true) => {
      if (!isOpen()) return;
      window.clearTimeout(hoverTimer);
      placeFrom();
      header.dataset.motion = instant ? 'none' : '';
      header.dataset.menu = 'closing';
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('is-locked');
      outside().forEach((el) => { el.inert = false; });
      const done = () => { menu.hidden = true; delete header.dataset.menu; header.dataset.motion = ''; pills.forEach((p) => p.reset()); };
      if (instant || reduced()) closeTimer = window.setTimeout(done, instant ? 0 : ms('--dur-fade-reduced', 150));
      else closeTimer = window.setTimeout(done, ms('--dur-morph-out', 180));
      if (restoreFocus) openBtn.focus({ preventScroll: true });
    };

    // One highlight glides between the rows under the pointer (the main links, and the Games list).
    const pills = [
      travellingPill(header.querySelector<HTMLElement>('.menu__links')!, '.menu__link', 'menu__hl'),
      travellingPill(header.querySelector<HTMLElement>('[data-games-scroll]')!, '.games__row', 'games__hl'),
    ];

    // Keyboard activations never animate (design system). A click counts as keyboard when no pointer made it.
    let keyed = false;
    header.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') keyed = true; });
    header.addEventListener('pointerdown', () => { keyed = false; });
    const fromKeys = (e: MouseEvent) => { const k = e.detail === 0 || keyed; keyed = false; return k; };

    const firstLink = () => menu.querySelector<HTMLElement>('.menu__links [aria-current="page"]') ?? menu.querySelector<HTMLElement>('.menu__links a');
    openBtn.addEventListener('click', (e) => {
      const k = fromKeys(e);
      if (isOpen()) return close(k);
      open(k);
      if (k) firstLink()?.focus({ preventScroll: true });
    });

    // A page can ask for the switcher ("Switch game" on a game hub): open on the Games list, current game first.
    document.addEventListener('vf:open-games', () => {
      if (!isOpen()) open(reduced());
      const row = menu.querySelector<HTMLElement>('.games [aria-current="page"]') ?? menu.querySelector<HTMLElement>('[data-game-row]');
      row?.focus({ preventScroll: true });
      row?.scrollIntoView({ block: 'nearest' });
    });

    // Focus stays in the header while the menu is open: the island's controls and the menu, in page order.
    const focusables = () => [...header.querySelectorAll<HTMLElement>('a[href], button, input, select')]
      .filter((el) => !el.closest('[hidden], [inert], .subbar') && el.getClientRects().length > 0);
    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') { e.preventDefault(); close(true); return; }
      if (e.key !== 'Tab') return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0], last = items[items.length - 1];
      if (!items.includes(document.activeElement as HTMLElement)) { e.preventDefault(); (e.shiftKey ? last : first).focus(); }
      else if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
    desktop.addEventListener('change', () => { if (isOpen()) placeFrom(); });
    addEventListener('resize', () => { if (isOpen()) placeFrom(); });
    // Leaving the page with the menu open (back and forward cache): come back closed.
    addEventListener('pageshow', (e) => { if ((e as PageTransitionEvent).persisted && isOpen()) close(true, false); });

    // Theme toggles (the island's and the menu's): the choice is remembered on this device; without one, the system
    // setting decides.
    const toggles = [...header.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')];
    const label = () => {
      const t = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      toggles.forEach((b) => b.setAttribute('aria-label', t === 'light' ? 'Switch to dark theme' : 'Switch to light theme'));
    };
    label();
    const setTheme = (next: 'light' | 'dark') => {
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('vf-theme', next); } catch { /* private mode: the choice lasts for this page only */ }
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#f9f5f0' : '#0d0c1a');
      label();
    };
    // The new theme opens as a circle from the toggle (motion study item 5): a same-page view transition whose new
    // snapshot is revealed by a growing circle, while the old one stays still underneath. Keyboard and reduced
    // motion keep the plain 200ms colour change.
    toggles.forEach((toggle) => toggle.addEventListener('click', (e) => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      const doc = document as Document & { startViewTransition?: (cb: () => void) => { ready: Promise<void>; finished: Promise<void> } };
      if (!doc.startViewTransition || fromKeys(e) || reduced()) { setTheme(next); return; }
      const r = toggle.getBoundingClientRect();
      const x = Math.round(r.left + r.width / 2), y = Math.round(r.top + r.height / 2);
      const end = Math.ceil(Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y)));
      const root = document.documentElement;
      root.classList.add('vt-theme');
      const vt = doc.startViewTransition(() => setTheme(next));
      vt.ready.then(() => {
        root.animate({ clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${end}px at ${x}px ${y}px)`] }, {
          duration: ms('--dur-theme', 520),
          easing: css.getPropertyValue('--ease-in-out').trim() || 'ease-in-out',
          pseudoElement: '::view-transition-new(root)',
        });
      }, () => {});
      vt.finished.finally(() => root.classList.remove('vt-theme'));
    }));
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    pointer-events: none;
    padding-top: calc(var(--island-top) + env(safe-area-inset-top, 0px));
  }
  .island-wrap {
    position: relative;
    z-index: 2; /* above the open menu: the island stays in place and its button closes the menu */
    width: var(--island-w);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--island-gap);
    pointer-events: auto;
  }

  /* The island. Its blur lives on ::before so it can sit in its own layer during page transitions. */
  .island {
    position: relative;
    display: flex;
    align-items: center;
    height: var(--island-h);
    padding-inline: 12px;
    color: var(--text-1);
    background: var(--glass-fill);
    border: var(--border-w) solid var(--glass-border);
    border-radius: var(--radius-xs);
    isolation: isolate;
  }
  /* Its own layer in page transitions, so it never redraws. Named only while a transition runs (the old page names
     it in pageswap, site-motion.ts): a named element is a backdrop root, and a permanent name would stop the island
     from blurring the page behind it. The theme circle reveals the island with everything else. */
  :global(html:active-view-transition) .island { view-transition-name: island; }
  :global(html.vt-theme) .island { view-transition-name: none; }
  .island::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: var(--radius-xs);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    z-index: -1;
  }
  .island__btn {
    display: inline-grid;
    place-items: center;
    width: 36px;
