{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thevicefiles.com/schema/games.schema.json",
  "title": "Games",
  "description": "content/games.json: the Rockstar games the GTAverse links to, the switcher groups, and where each official logo file comes from (decisions GS1 to GS4). Logo files are never committed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated", "updated_at", "logo_policy", "groups", "items"],
  "properties": {
    "generated": { "type": "string", "format": "date" },
    "updated_at": { "type": "string", "format": "date" },
    "logo_policy": { "type": "string", "minLength": 1 },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/game" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "short_name", "year", "universe", "group", "aliases", "logo"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "description": "The full title, as the publisher writes it." },
        "short_name": { "type": "string", "minLength": 1, "description": "The name shown in switcher rows and chips." },
        "year": { "type": "integer", "minimum": 1997, "maximum": 2100, "description": "First release year (src/lib/lore.ts)." },
        "universe": { "enum": ["2D", "3D", "HD", "Red Dead", "other"] },
        "group": { "$ref": "#/$defs/id", "description": "A groups[].id: where the game sits in the switcher. 'more' games are listed on /gtaverse/games only." },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Every exact string used for this game in connections.games and finds.crossover_games. The normalisation map: content text is never rewritten."
        },
        "logo": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/logo" }] },
        "logo_note": { "type": "string", "minLength": 1, "description": "Why there is no logo (a text plate is shown)." }
      }
    },
    "logo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_url", "file_url", "file", "alt_on_source", "retrieved", "sha256", "bytes", "width", "height", "licence_note"],
      "properties": {
        "page_url": { "type": "string", "format": "uri", "pattern": "^https://(www\\.)?(rockstargames\\.com|take2games\\.com)/", "description": "The official page the logo appears on." },
        "file_url": { "type": "string", "format": "uri", "pattern": "^https://(www\\.rockstargames\\.com|media-rockstargames-com\\.akamaized\\.net|media\\.rockstargames\\.com|www\\.take2games\\.com)/", "description": "The file as that page loads it. Official hosts only." },
        "file": { "type": "string", "pattern": "^[a-z0-9-]+\\.(svg|png|webp)$", "description": "File name under public/media/logos/ (git-ignored)." },
        "alt_on_source": { "type": "string", "description": "The alt text the official page gives the image, to show which image was taken." },
        "retrieved": { "type": "string", "format": "date" },
        "sha256": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }] },
        "bytes": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
        "width": { "oneOf": [{ "type": "null" }, { "type": "number", "exclusiveMinimum": 0 }] },
        "height": { "oneOf": [{ "type": "null" }, { "type": "number", "exclusiveMinimum": 0 }] },
        "licence_note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
