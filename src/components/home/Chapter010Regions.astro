---
// Home 010, Regions (phase 7d, the owner's taste-board Loves; LR68 to LR72, direction file direction-home-regions.md).
// Desktop and tablet (768 and up): Craft Agency's giant stacked names. Every area is a name in display caps, centred,
// the chosen one solid and slanted with up to two pink tags (the places inside it with the most finds), and one small
// card under the stack with that area's content: up to three of its finds, its count and a link to its region page.
// Phone: Luma's list. Each area is a row with a round mark (the glyph of the find type it has most of, from our own
// icon family), its name and its count; the same card sits under the list.
// One set of controls: each area is one button whose parts change with the layout.
// Areas: Leonida's counties and regions (the regions whose parent is the state) that hold at least one find that is
// safe to show, most finds first. Finds of an area are its own and its sub-areas'. Spoiler and mature finds are never
// named here; the count is every published find, the number the region page shows.
import ChapterHead from './ChapterHead.astro';
import { regions, categories, type Find } from '../../lib/content';
import { findsInRegion, hasRegionHub, subtree } from '../../lib/hubs';
import { categoryGlyphs } from '../../icons/family';
import { iconSvg } from '../../icons/render';

interface Props { index?: string }
const { index = '010' } = Astro.props;

const state = regions.find((r) => r.parent === null);
const safe = (f: Find) => !f.spoiler && !f.mature;
const catOrder = categories.filter((c) => c.kind === 'find').map((c) => c.id);
const tops = regions.filter((r) => r.parent === state?.id && (r.type === 'county' || r.type === 'region'));
const inside = (f: Find, ids: Set<string>) => f.region_ids.some((id) => ids.has(id));
const areas = tops
  .map((r) => {
    const all = findsInRegion(r.id);
    const shown = all.filter(safe);
    // The card's finds: the best sourced first (multi-source), then the content's order.
    const top = [...shown.filter((f) => f.verification === 'multi-source'), ...shown.filter((f) => f.verification !== 'multi-source')].slice(0, 3);
    // The mark: the find type the area has most of (ties by the categories' order).
    const tally = new Map<string, number>();
    shown.forEach((f) => tally.set(f.category, (tally.get(f.category) ?? 0) + 1));
    const cat = [...tally.entries()].sort((a, b) => b[1] - a[1] || catOrder.indexOf(a[0]) - catOrder.indexOf(b[0]))[0]?.[0];
    const glyph = (cat && categoryGlyphs[cat as keyof typeof categoryGlyphs]) || 'pin';
    // The tags: the two places inside the area that hold the most of its safe finds.
    const tags = regions
      .filter((p) => p.id !== r.id && subtree(r.id).includes(p.id))
      .map((p) => { const ids = new Set(subtree(p.id)); return { name: p.name, n: shown.filter((f) => inside(f, ids)).length }; })
      .filter((p) => p.n > 0)
      .sort((a, b) => b.n - a.n || a.name.localeCompare(b.name))
      .slice(0, 2)
      .map((p) => p.name);
    return { id: r.id, name: r.name, count: all.length, shown: shown.length, top, glyph, tags, hub: hasRegionHub(r.id) };
  })
  .filter((a) => a.shown > 0)
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
const findsLabel = (n: number) => (n === 1 ? '1 find' : `${n} finds`);
---
<section class="ch10" aria-labelledby="ch10-title" data-ch10>
  <div class="container"><ChapterHead index={index} label="Regions" id="ch10-title" /></div>
  <div class="ch10__stage container">
    <p class="ch10__intro">The areas of {state?.name ?? 'Leonida'} and what fans have found in each. Choose one to see its finds.</p>
    <p class="ch10__group" aria-hidden="true">{state?.name ?? 'Leonida'}</p>
    <ul class="ch10__list" role="list" aria-label={`Areas of ${state?.name ?? 'Leonida'}`}>
      {areas.map((a, i) => (
        <li class="ch10__item" style={`--i: ${i}`}>
          <button type="button" class:list={['ch10__area', { 'is-active': i === 0 }]} data-ch10-area={i} data-name={a.name} data-count={findsLabel(a.count)} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="ch10-card">
            <span class="ch10__mark" set:html={iconSvg(a.glyph, { size: 16 })} />
            <span class="ch10__name">
              <span class="ch10__up">{a.name}</span>
              <span class="ch10__it" aria-hidden="true">{a.name}</span>
              {a.tags.length > 0 && <span class="ch10__tags" aria-hidden="true" data-ch10-tags={i} hidden={i !== 0}>{a.tags.map((t) => <span class="ch10__tag">{t}</span>)}</span>}
            </span>
            <span class="ch10__n">{findsLabel(a.count)}</span>
          </button>
        </li>
      ))}
    </ul>
    <div class="ch10__card" id="ch10-card">
      {areas.map((a, i) => (
        <div class="ch10__panel" role="group" aria-label={a.name} data-ch10-panel={i} hidden={i !== 0}>
          <ul class="ch10__finds" role="list">
            {a.top.map((f) => <li><a class="ch10__find" href={`/finds/${f.slug}`}>{f.title}</a></li>)}
          </ul>
          <p class="ch10__foot">
            <span class="ch10__count">{findsLabel(a.count)}</span>
            {a.hub && <a class="ch10__all" href={`/regions/${a.id}`}>All finds in {a.name}</a>}
          </p>
        </div>
      ))}
    </div>
    <p class="sr-only" aria-live="polite" data-ch10-status></p>
  </div>
</section>

<style>
  .ch10 { padding-top: var(--space-chapter); overflow-x: clip; }
  .ch10__stage { margin-top: var(--space-16); container-type: inline-size; display: flex; flex-direction: column; align-items: center; }
  .ch10__intro, .ch10__group, .ch10__mark, .ch10__n { display: none; }

  /* The stack (Craft Agency): names in display caps, centred, line pitch 1.22 x the cap height, sized so seven names
     and the card fit one 900px screen (LR68). */
  .ch10__list { display: flex; flex-direction: column; align-items: center; width: 100%; }
  .ch10__item { display: flex; justify-content: center; max-width: 100%; }
  .ch10__area {
    display: inline-flex;
    max-width: 100%;
    font-family: var(--font-display);
    font-variation-settings: var(--font-display-axes);
    font-weight: 500;
    font-size: min(7.8cqi, 112px);
    line-height: 1;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
    cursor: pointer;
  }
  .ch10__name { position: relative; display: block; }
  .ch10__up, .ch10__it { display: block; color: var(--text-1); transition: opacity var(--dur-colour) var(--ease-colour); }
  /* The other names: the text colour at 56%, Craft's pale names kept readable (3.3:1 on cream, large text AA). */
  .ch10__up { opacity: 0.56; }
  /* The chosen name is solid and slanted: a copy of the word with a static skew (Big Shoulders has no italic) that
     crossfades with the upright one, so nothing moves. */
  .ch10__it { position: absolute; inset: 0; transform: skewX(-11deg); opacity: 0; }
  .ch10__area.is-active .ch10__up { opacity: 0; }
  .ch10__area.is-active .ch10__it { opacity: 1; }
  @media (hover: hover) and (pointer: fine) {
    .ch10__area:not(.is-active):hover .ch10__up { opacity: 0.8; }
  }

  /* The tags on the chosen name: the places inside it with the most finds. */
  .ch10__tags { position: absolute; inset: 0; pointer-events: none; }
  .ch10__tag {
    position: absolute;
    display: block;
    max-width: 14em;
    padding: 0 0.6em;
    font-family: var(--font-display);
    font-variation-settings: var(--font-display-axes);
    font-weight: 800;
    font-size: max(12px, 0.163em);
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: var(--radius-full);
    white-space: nowrap;
    overflow: clip visible;
    text-overflow: ellipsis;
  }
  .ch10__tag:nth-child(1) { left: 3%; top: 44%; }
  .ch10__tag:nth-child(2) { left: 63%; top: 54%; }
  /* The tags follow the name's size (15px on a 92px name); under 1024 the names are too small to carry them. */
  @media (max-width: 1023px) { .ch10__tags { display: none; } }

  /* The card (Craft's small card under the stack, in the site's framed card style). Every area's panel shares one
     grid cell, so the card keeps the height of the tallest and nothing below it moves on a swap. */
  .ch10__card {
    display: grid;
    width: min(440px, 100%);
    margin-top: var(--space-10);
    padding: var(--space-4);
    background: var(--surface-1);
    border: var(--border-w) solid var(--border-1);
    border-radius: var(--radius-l);
  }
  .ch10__panel { grid-area: 1 / 1; min-width: 0; }
  .ch10__panel[hidden] { display: block; visibility: hidden; }
  .ch10__finds li { min-width: 0; }
  .ch10__find {
    display: block;
    font-size: var(--text-body);
    line-height: 1.5;
    color: var(--text-1);
    white-space: nowrap;
    overflow: clip visible;
    text-overflow: ellipsis;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .ch10__foot { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-3); font-size: var(--text-body); line-height: 1.5; }
  .ch10__count { flex: none; color: var(--text-2); font-variant-numeric: tabular-nums; }
  .ch10__all { min-width: 0; color: var(--text-1); text-align: right; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) {
    .ch10__find:hover { text-decoration-line: underline; }
    .ch10__all:hover { color: var(--accent-text); }
  }

  /* Phone (Luma): the areas as a list, a round mark, the name and the count on each row; the card under it. */
  @media (max-width: 767px) {
    .ch10__stage { display: block; margin-top: var(--space-6); }
    .ch10__intro { display: block; font-size: var(--text-body-s); line-height: 1.35; color: var(--text-3); max-width: 36em; }
    .ch10__group { display: block; margin-top: var(--space-6); margin-bottom: var(--space-2); font-size: var(--text-body); font-weight: 500; line-height: 1.35; color: var(--text-3); }
    .ch10__list { display: block; }
    .ch10__item { display: block; }
    .ch10__area {
      display: grid;
      grid-template-columns: 32px minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 14px;
      width: 100%;
      min-height: var(--space-12);
      font-family: var(--font-body);
      font-variation-settings: normal;
      font-size: var(--text-title-l);
      font-weight: 500;
      line-height: 1.3;
      letter-spacing: 0;
      text-transform: none;
      text-align: left;
    }
    .ch10__mark {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      border-radius: var(--radius-full);
      background: var(--inverse-fill);
      color: var(--inverse-text);
      transition: transform var(--dur-press) var(--ease-out);
    }
    /* The chosen row's mark turns pink at once: a colour does not animate here (only transform and opacity do). */
    .ch10__area.is-active .ch10__mark { background: var(--accent); color: var(--on-accent); }
    .ch10__area:active .ch10__mark { transform: scale(0.94); }
    .ch10__name { min-width: 0; }
    .ch10__up, .ch10__area.is-active .ch10__up, .ch10__area:hover .ch10__up { opacity: 1; overflow: clip visible; text-overflow: ellipsis; }
    .ch10__it, .ch10__tags { display: none; }
    .ch10__n { display: block; font-weight: 400; color: var(--text-3); font-variant-numeric: tabular-nums; }
    .ch10__card { width: 100%; margin-top: var(--space-8); }
    /* Touch targets: every link in the card is 44 high. */
    .ch10__find { line-height: 44px; }
    .ch10__foot { align-items: center; margin-top: 0; }
    .ch10__all { display: flex; align-items: center; justify-content: flex-end; min-height: 44px; }
  }

  /* A keyboard choice changes the names at once (keyboard actions never animate). */
  .ch10.is-instant .ch10__up, .ch10.is-instant .ch10__it, .ch10.is-instant .ch10__mark { transition: none; }

  /* First view, once: the names rise with a short shrinking stagger, the card fades in after them. */
  :global(html.js) .ch10:not([data-fv-in]) :is(.ch10__item, .ch10__card) { opacity: 0; }
  .ch10[data-fv-in='in'] .ch10__item { animation: ch10-rise var(--dur-reveal-group) var(--ease-reveal) calc(var(--i) * 40ms - var(--i) * var(--i) * 3ms) both; }
  .ch10[data-fv-in='in'] .ch10__card { animation: ch10-in var(--dur-reveal-group) var(--ease-out) 160ms both; }
  @keyframes ch10-rise { from { opacity: 0; translate: 0 12px; } }
  @keyframes ch10-in { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .ch10[data-fv-in='in'] .ch10__item { animation: ch10-in var(--dur-fade-reduced) var(--ease-colour) both; }
    .ch10[data-fv-in='in'] .ch10__card { animation: ch10-in var(--dur-fade-reduced) var(--ease-colour) both; }
    .ch10__mark { transition: none; }
    .ch10__area:active .ch10__mark { transform: none; }
  }
</style>

<script>
  import { onFirstView, reduceMotion } from './first-view';
  import { tokenMs } from '../../scripts/motion/tokens';

  for (const root of document.querySelectorAll<HTMLElement>('[data-ch10]')) {
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-ch10-area]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-ch10-panel]')];
    const tagsOf = (i: number) => root.querySelector<HTMLElement>(`[data-ch10-tags="${i}"]`);
    const status = root.querySelector<HTMLElement>('[data-ch10-status]')!;
    let area = 0;

    onFirstView([root], (el) => { el.dataset.fvIn = 'in'; }, (el) => { el.dataset.fvIn = 'skip'; });

    // The chosen name: solid and slanted (desktop), a crossfade of the upright and slanted copies over --dur-colour;
    // on the phone the chosen row's mark turns pink at once. A keyboard choice switches everything at once.
    const mark = (i: number, instant: boolean) => {
      if (instant) root.classList.add('is-instant');
      btns.forEach((b, k) => { b.classList.toggle('is-active', k === i); b.setAttribute('aria-pressed', String(k === i)); });
      if (instant) { void root.offsetWidth; root.classList.remove('is-instant'); }
    };

    // The swap (LR13, LR25): the shown area's card content and tags fade out over --dur-swap-out, and only then does
    // the new area's arrive over --dur-swap-in. Every change of mind starts from where the shown area is right now:
    // another area fades it on down to 0, choosing it again brings it back up to 1. Each fade reads the current
    // opacity first, so nothing ever jumps, and only the latest choice acts (turn). Nothing in the card rises, so
    // nothing can rise while an area leaves (LR36). Keyboard choices and reduced motion swap at once, at rest (LR37).
    const css = (prop: string) => getComputedStyle(document.documentElement).getPropertyValue(prop).trim();
    let target = 0;
    let turn = 0;
    const shownIndex = () => panels.findIndex((p) => !p.hidden);
    const elsOf = (k: number) => [panels[k], tagsOf(k)].filter((el): el is HTMLElement => !!el);
    // Fades `el` from its current opacity to `to`, over the part of `full` that distance needs.
    const fadeTo = (el: HTMLElement, to: 0 | 1, full: number, ease: string) => {
      const from = Math.min(1, Math.max(0, parseFloat(getComputedStyle(el).opacity) || 0));
      el.getAnimations().forEach((a) => a.cancel());
      return el.animate([{ opacity: from }, { opacity: to }], { duration: Math.max(1, full * Math.abs(to - from)), easing: ease, fill: 'forwards' });
    };
    const show = (i: number, still: boolean) => {
      turn++;
      panels.forEach((_, k) => elsOf(k).forEach((el) => { el.getAnimations().forEach((a) => a.cancel()); el.hidden = k !== i; }));
      if (!still) elsOf(i).forEach((el) => el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: tokenMs('--dur-swap-in', 280), easing: css('--ease-out') }));
    };

    const select = (i: number, byKey = false) => {
      if (i === area) return;
      area = i;
      target = i;
      mark(i, byKey);
      status.textContent = `${btns[i].dataset.name}: ${btns[i].dataset.count}`;
      if (byKey || reduceMotion()) show(i, true);
      else if (i === shownIndex()) {
        // Back to the area that is still on screen (leaving): bring it back up from where it is.
        const t = ++turn;
        const anims = elsOf(i).map((el) => fadeTo(el, 1, tokenMs('--dur-swap-in', 280), css('--ease-out')));
        Promise.all(anims.map((a) => a.finished)).then(() => { if (t === turn) anims.forEach((a) => a.cancel()); }, () => {});
      } else {
        const t = ++turn;
        const anims = elsOf(shownIndex()).map((el) => fadeTo(el, 0, tokenMs('--dur-swap-out', 180), css('--ease-standard')));
        Promise.all(anims.map((a) => a.finished)).then(() => { if (t === turn) show(target, false); }, () => {});
      }
    };
    btns.forEach((b, i) => b.addEventListener('click', (e) => select(i, e.detail === 0)));
  }
</script>
