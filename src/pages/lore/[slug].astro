---
import Base from '../../layouts/Base.astro';
import { connections, findBySlug, type Connection } from '../../lib/content';
export function getStaticPaths() {
  return connections.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Connection };
const related = (c.related_finds ?? []).map((id) => findBySlug(id)).filter(Boolean);
---
<Base title={c.title} description={c.summary}>
  <article>
    <p>{c.type}, {c.confidence}</p>
    <h1>{c.title}</h1>
    <p>Games: {c.games.join(', ')}</p>
    <p>{c.summary}</p>
    {related.length > 0 && (<><h2>See it in GTA VI</h2><ul>{related.map((f) => <li><a href={`/finds/${f!.slug}`}>{f!.title}</a></li>)}</ul></>)}
    <h2>Sources</h2>
    <ul>{c.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title ?? s.url}</a></li>)}</ul>
  </article>
</Base>
