---
// The site footer (round 2: HUXLEY 014 base; Kacio Felipe C04, Eat Hungry Tiger and A24 phone, all Loves).
// Top to bottom: a closing line over an official wallpaper (the About page's three "How it is made" principles, owner
// answer Q2; the wallpaper as-is and credited, Q1), the wordmark fitted to the content width, a ruled grid of link
// cells with mono labels, the legal copy (keep the two legal paragraphs word for word), a dotted rule with the credit
// row, and an art strip at the very bottom. Without built wallpapers the band sits on the sunrise glow and the strip
// is left out.
import { nav, isCurrent } from '../../lib/nav';
import { trustPages } from '../../lib/trust';
import { submitFindLink, correctionLink } from '../../lib/issues';
import { site } from '../../lib/site';
import { creditTotals } from '../../lib/credits';
import { wallpaper } from '../../lib/wallpaper';
import Icon from '../ui/Icon.astro';

const path = Astro.url.pathname;
const scene = wallpaper(3);
const strip = wallpaper(1);
const year = new Date().getUTCFullYear();
type L = { href: string; label: string; note?: string; external?: boolean };
const label = (href: string) => nav.find((n) => n.href === href)?.label ?? href;
const cells: { title: string; links: L[] }[] = [
  { title: 'The guide', links: [{ href: '/finds', label: label('/finds') }, { href: '/map', label: label('/map') }, { href: '/explainers', label: label('/explainers') }, { href: '/gtaverse', label: label('/gtaverse') }, { href: '/gtaverse/games', label: 'Games' }] },
  { title: 'About', links: trustPages.filter((p) => p.href !== '/finders').map((p) => ({ href: p.href, label: p.label })) },
  { title: 'Credits', links: [{ href: '/finders', label: 'Finders', note: `${creditTotals.people} people, ${creditTotals.outlets} outlets` }, { href: submitFindLink(), label: 'Submit a find', external: true }, { href: correctionLink(), label: 'Suggest a correction', external: true }] },
  { title: 'Open', links: [{ href: '/data', label: 'Open data' }, { href: '/rss.xml', label: 'RSS feed' }, { href: site.repo, label: 'Source on GitHub', external: true }] },
];
const lines = ['No source link, no fact.', 'Credit the finder.', 'Our own words.'];
---
<footer class="site-footer" data-footer>
  <section class="ft-close" data-scheme="dark" aria-label="How it is made">
    {scene ? (
      <picture class="ft-close__art" aria-hidden="true">
        {scene.sources.map((s) => <source type={s.type} srcset={s.srcset} sizes="100vw" />)}
        <img src={scene.src} alt="" loading="lazy" decoding="async" style={`object-position: ${scene.position}`} />
      </picture>
    ) : <span class="ft-close__glow" aria-hidden="true"></span>}
    <div class="ft-close__inner">
      <div class="ft-close__box">
        <span class="ft-close__rule ft-close__rule--top" aria-hidden="true"></span>
        <p class="ft-close__line">{lines.map((l, i) => <span style={`--i: ${i}`}>{l}</span>)}</p>
        <span class="ft-close__rule ft-close__rule--bottom" aria-hidden="true"></span>
      </div>
      <span class="ft-close__dot" aria-hidden="true"></span>
      <a class="ft-close__by" href="/about">The Vice Files, how it is made</a>
    </div>
    {scene && <p class="ft-close__credit">{scene.credit}</p>}
  </section>

  <div class="container ft-main">
    <a class="ft-mark" href="/" aria-label="The Vice Files, home">
      <span class="ft-mark__clip"><span class="ft-mark__word" aria-hidden="true">The Vice Files</span></span>
    </a>

    <nav class="ft-grid" aria-label="Footer">
      {cells.map((c) => (
        <div class="ft-cell">
          <p class="ft-cell__label"><span class="ft-cell__bullet" aria-hidden="true"></span>{c.title}</p>
          <ul class="ft-cell__links" role="list">
            {c.links.map((l) => {
              const current = !l.external && isCurrent(path, l.href);
              return (
                <li>
                  <a class="ft-link" href={l.href} aria-current={current ? 'page' : undefined} rel={l.external ? 'noopener' : undefined}>
                    {current && <span class="ft-link__here" aria-hidden="true"></span>}
                    <span class="ft-link__text">{l.label}{l.external && <Icon name="arrow-up-right" size={12} stroke={2} class="ft-link__out" />}</span>
                  </a>
                  {l.note && <span class="ft-link__note">{l.note}</span>}
                </li>
              );
            })}
          </ul>
        </div>
      ))}
      <div class="ft-cell ft-cell--contact">
        <p class="ft-cell__label"><span class="ft-cell__bullet" aria-hidden="true"></span>Contact</p>
        <ul class="ft-cell__links" role="list">
          <li><a class="ft-link ft-link--mail" href={`mailto:${site.takedownEmail}`}><span class="ft-link__text">{site.takedownEmail}</span></a></li>
          <li><a class="ft-link ft-link--mail" href={`mailto:${site.conductEmail}`}><span class="ft-link__text">{site.conductEmail}</span></a></li>
        </ul>
        {site.responseHours && <p class="ft-cell__note">Takedowns answered within {site.responseHours} hours</p>}
      </div>
    </nav>

    <div class="ft-legal">
      <p>The Vice Files is an unofficial, non-commercial fan project. It is not affiliated with or endorsed by Rockstar Games or Take-Two Interactive. Grand Theft Auto, GTA and related names, images, materials and their logos are trademarks and copyrights of their respective owners. Clips play from their creators' own posts.</p>
      <p>Takedowns and credit corrections: <a class="link" href="mailto:takedown@thevicefiles.com">takedown@thevicefiles.com</a></p>
    </div>

    <div class="ft-credits">
      <span class="ft-dots" aria-hidden="true"></span>
      <div class="ft-credits__row">
        <p>© {year} The Vice Files contributors</p>
        <p><a href={`${site.repo}/blob/staging/LICENSE-CONTENT`} rel="noopener">Content CC BY-NC 4.0</a> · <a href={`${site.repo}/blob/staging/LICENSE`} rel="noopener">Code MIT</a></p>
        <p>Unofficial fan project</p>
      </div>
    </div>
  </div>

  {strip && (
    <div class="ft-strip" data-scheme="dark">
      <picture class="ft-strip__art" aria-hidden="true">
        {strip.sources.map((s) => <source type={s.type} srcset={s.srcset} sizes="max(250vw, 1600px)" />)}
        <img src={strip.src} alt="" loading="lazy" decoding="async" />
      </picture>
      <p class="ft-strip__credit">{strip.credit}</p>
    </div>
  )}
</footer>

<style>
  .site-footer { padding-bottom: env(safe-area-inset-bottom, 0px); }

  /* ---------- 1. Closing line over a scene (HUXLEY 014) ---------- */
  .ft-close { position: relative; isolation: isolate; display: grid; place-items: center; height: 400px; overflow: hidden; background: var(--bg); }
  .ft-close__art, .ft-close__glow { position: absolute; inset: 0; z-index: -1; }
  .ft-close__art img { width: 100%; height: 100%; object-fit: cover; }
  .ft-close__art::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, rgb(13 12 26 / 0.62), rgb(13 12 26 / 0.74) 60%, rgb(13 12 26 / 0.96)); }
  .ft-close__glow { background: var(--glow-hero); }
  .ft-close__inner { display: flex; flex-direction: column; align-items: center; gap: var(--space-3); padding-inline: var(--gutter); }
  .ft-close__box { position: relative; width: min(860px, 100%); padding: var(--space-4) var(--space-6); border-inline: 1px solid rgb(255 255 255 / 0.18); }
  /* The ruled box: hairlines above and below the line, with a small crosshair where each one ends. */
  .ft-close__rule { position: absolute; left: 0; right: 0; height: 1px; background: rgb(255 255 255 / 0.18); }
  .ft-close__rule--top { top: 0; }
  .ft-close__rule--bottom { bottom: 0; }
  .ft-close__rule::before, .ft-close__rule::after { content: ''; position: absolute; top: -4px; width: 9px; height: 9px; background: linear-gradient(rgb(255 255 255 / 0.5), rgb(255 255 255 / 0.5)) center / 1px 100% no-repeat, linear-gradient(rgb(255 255 255 / 0.5), rgb(255 255 255 / 0.5)) center / 100% 1px no-repeat; }
  .ft-close__rule::before { left: -4px; }
  .ft-close__rule::after { right: -4px; }
  .ft-close__line { display: flex; flex-direction: column; align-items: center; font-family: var(--font-mono); font-weight: 400; font-size: 36px; line-height: 1.14; letter-spacing: 0.02em; text-transform: uppercase; text-align: center; color: rgb(255 255 255 / 0.92); }
  .ft-close__dot { width: 4px; height: 4px; background: rgb(255 255 255 / 0.92); margin-top: var(--space-2); }
  .ft-close__by { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-mono); font-size: var(--text-mono-caps); letter-spacing: 0.1em; text-transform: uppercase; color: rgb(255 255 255 / 0.72); }
  .ft-close__credit, .ft-strip__credit { position: absolute; right: var(--gutter); bottom: var(--space-3); font-size: var(--text-caption); color: rgb(255 255 255 / 0.72); }

  /* ---------- 2. Wordmark (HUXLEY 014, Eat Hungry Tiger): one word fitted to the content width ---------- */
  .ft-main { padding-top: var(--space-6); }
  .ft-mark { display: block; container-type: inline-size; color: var(--text-1); }
  /* The clip that reveals the word sits on a wrapper with room for every glyph (padding cancelled by the margin). */
  .ft-mark__clip { display: block; padding-block: 0.12em; margin-block: -0.12em -0.3em; font-size: calc(100cqi / var(--mark-ratio, 6.62)); }
  .ft-mark__word {
    display: inline-block;
    font-family: var(--font-display);
    font-variation-settings: var(--font-display-axes);
    font-weight: 900;
    font-size: 1em;
    line-height: 0.8;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    white-space: nowrap;
    padding-block: 0.06em;
  }
  :global(html.js) .ft-mark:not([data-fv]) .ft-mark__clip { clip-path: inset(100% 0 0 0); }
  .ft-mark[data-fv='in'] .ft-mark__clip { animation: ft-rise var(--dur-reveal) var(--ease-reveal) both; }
  @keyframes ft-rise { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0); } }

  /* ---------- 3. Ruled link cells (HUXLEY 014 columns, Kacio C04 vertical rules) ---------- */
  .ft-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.15fr) minmax(0, 1fr) minmax(0, 1.3fr); margin-top: 0; border-block: var(--border-w) solid var(--rule-soft); }
  .ft-cell { display: flex; flex-direction: column; gap: var(--space-4); padding: var(--space-6); min-width: 0; }
  .ft-cell + .ft-cell { border-left: var(--border-w) solid var(--rule-soft); }
  .ft-cell:first-child { padding-left: 0; }
  .ft-cell__label { display: flex; align-items: center; gap: var(--space-2); font-family: var(--font-mono); font-size: var(--text-mono-caps); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3); line-height: 1.4; }
  .ft-cell__bullet { width: 6px; height: 6px; background: currentColor; flex: none; }
  .ft-cell__links { display: flex; flex-direction: column; }
  .ft-link { position: relative; display: inline-flex; align-items: center; gap: 6px; min-height: 32px; font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-1); line-height: 1.35; max-width: 100%; }
  .ft-link--mail { text-transform: none; letter-spacing: 0; overflow-wrap: anywhere; }
  .ft-link__text { position: relative; min-width: 0; }
  /* Hover: a 1px underline draws in from the left. */
  .ft-link__text::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 1px; background: currentColor; clip-path: inset(0 100% 0 0); transition: clip-path var(--dur-colour) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .ft-link:hover .ft-link__text::after { clip-path: inset(0); }
  }
  .ft-link__text :global(.ft-link__out) { display: inline; vertical-align: 0; margin-left: 6px; }
  .ft-link__here { width: 6px; height: 6px; background: var(--accent-ink); flex: none; }
  .ft-link:focus-visible { outline: 2px solid var(--accent-ink); outline-offset: 3px; border-radius: 2px; }
  .ft-link__note { display: block; margin-top: -4px; margin-bottom: 4px; font-size: var(--text-caption); color: var(--text-3); }
  .ft-cell__note { font-size: var(--text-caption); color: var(--text-3); line-height: 1.4; }
  @media (pointer: coarse) { .ft-link { min-height: 44px; } }

  /* ---------- 4. Legal: the current copy, two columns ---------- */
  .ft-legal { display: grid; grid-template-columns: repeat(2, minmax(0, 520px)); justify-content: space-between; gap: var(--space-6) var(--space-10); margin-top: var(--space-10); font-size: var(--text-body-s); line-height: 22px; color: var(--text-2); }

  /* ---------- 5. Dotted rule and credit row (Eat Hungry Tiger) ---------- */
  .ft-credits { margin-top: var(--space-16); }
  .ft-dots { display: block; height: 4px; background: var(--rule-dotted); }
  .ft-credits__row { display: grid; grid-template-columns: 50% minmax(0, 1fr) auto; gap: var(--space-6); padding-block: var(--space-6) var(--space-10); font-family: var(--font-mono); font-size: var(--text-mono-caps); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); line-height: 1.4; }
  .ft-credits__row a { color: inherit; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: text-decoration-color var(--dur-colour) var(--ease-colour); display: inline-flex; align-items: center; min-height: 32px; }
  .ft-credits__row p { display: flex; align-items: center; flex-wrap: wrap; gap: 0 6px; min-height: 32px; }
  @media (hover: hover) and (pointer: fine) { .ft-credits__row a:hover { text-decoration-color: currentColor; } }

  /* ---------- 6. Art strip (Kacio Felipe C04): the wallpaper, fading up into the ground ---------- */
  .ft-strip { position: relative; height: 200px; overflow: hidden; }
  /* Cropped to the skyline and the water at the left of the wallpaper (the picture is placed, never altered). */
  .ft-strip__art img { position: absolute; left: 0; top: 50%; width: max(250%, 1600px); max-width: none; height: auto; translate: 0 -54%; }
  .ft-strip::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(to bottom, var(--page-bg, #0d0c1a), rgb(13 12 26 / 0) 70%); pointer-events: none; }
  :global(html[data-theme='light']) .ft-strip { --page-bg: #f9f5f0; }
  .ft-strip__art { position: absolute; inset: 0; }
  .ft-strip__credit { z-index: 2; }

  /* First view: the closing lines rise one after another, the wordmark rises out of its baseline. */
  :global(html.js) .ft-close:not([data-fv]) .ft-close__line span { opacity: 0; }
  .ft-close[data-fv='in'] .ft-close__line span { animation: ft-line var(--dur-reveal) var(--ease-reveal) calc(var(--i) * 70ms - var(--i) * var(--i) * 6ms) both; }
  @keyframes ft-line { from { opacity: 0; translate: 0 16px; } }
  @keyframes ft-fade { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .ft-close[data-fv='in'] .ft-close__line span { animation: ft-fade var(--dur-fade-reduced) var(--ease-colour) both; }
    .ft-mark[data-fv='in'] .ft-mark__clip { animation: ft-fade var(--dur-fade-reduced) var(--ease-colour) both; }
    .ft-link__text::after, .ft-credits__row a { transition: none; }
  }
  :global(html.rv-off) .ft-close .ft-close__line span { opacity: 1; }
  :global(html.rv-off) .ft-mark .ft-mark__clip { clip-path: none; }

  @media (max-width: 1023px) {
    .ft-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ft-cell { padding: var(--space-5) var(--space-4); border-top: var(--border-w) solid var(--rule-soft); }
    .ft-cell:nth-child(-n + 2) { border-top: 0; }
    .ft-cell + .ft-cell { border-left: 0; }
    .ft-cell:nth-child(even) { border-left: var(--border-w) solid var(--rule-soft); }
    .ft-cell:nth-child(odd) { padding-left: 0; }
    .ft-cell--contact { grid-column: 1 / -1; border-left: 0 !important; padding-left: 0; }
    .ft-legal { grid-template-columns: minmax(0, 1fr); }
    .ft-credits__row { grid-template-columns: minmax(0, 1fr); gap: 0; }
  }
  @media (max-width: 767px) {
    .ft-close { height: 280px; }
    .ft-close__line { font-size: 20px; line-height: 1.25; }
    .ft-close__box { padding-block: var(--space-3); }
    .ft-close__credit { right: var(--gutter); }
    .ft-legal { font-size: var(--text-body-s); }
    .ft-credits { margin-top: var(--space-16); }
    .ft-strip { height: 120px; }
    .ft-link { min-height: 44px; }
    .ft-credits__row a, .ft-credits__row p { min-height: 44px; }
  }
</style>

<script>
  import { onFirstView } from '../home/first-view';
  const footer = document.querySelector<HTMLElement>('[data-footer]');
  if (footer) {
    const mark = footer.querySelector<HTMLElement>('.ft-mark');
    const close = footer.querySelector<HTMLElement>('.ft-close');
    // Fit the wordmark exactly to the content width: measure the word once its font has loaded.
    const word = footer.querySelector<HTMLElement>('.ft-mark__word');
    const fit = () => {
      if (!mark || !word) return;
      const fs = parseFloat(getComputedStyle(word).fontSize);
      const w = word.scrollWidth;
      if (fs && w) mark.style.setProperty('--mark-ratio', String(w / fs));
    };
    document.fonts?.ready.then(fit);
    const run = (el: HTMLElement) => { el.dataset.fv = 'in'; };
    const skip = (el: HTMLElement) => { el.dataset.fv = 'skip'; };
    onFirstView([mark, close].filter(Boolean) as HTMLElement[], run, skip, '0px 0px -10% 0px');
  }
</script>
