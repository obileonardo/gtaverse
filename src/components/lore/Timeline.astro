---
// The lore timeline, one selected moment at a time.
// Desktop (Grok, Love): headline left, intro right at 61%; a hairline across the full width with mono caps year
// labels above it, each on a 1px tick; event dots on the line and a square marker around the selected one; the
// selected moment's date, title and description under the marker. V7 (Love) adds the tick ruler hanging from the
// line, event ticks in the accent and two outline arrow pills. The moment's clip sits to the right of its text in
// Queue's polaroid frame.
// Phone (Queue, Love): a year ruler at the top of a sheet (ticks scroll under a fixed centre tick), the centred
// year with its neighbours fading at the edges, then a quote led serif headline, the polaroid clip, a "Watch the
// clip" link and the serif body. Scrub the ruler or swipe the moment to move.
// Every moment is in the page, so switching is instant and works offline; the selected one is server rendered.
// syncUrl: on a lore page, the address follows the selected moment.
// titleAsH1: on a lore page, the page heading also names the selected moment (for readers; the eye sees it under
// the marker).
// headingLevel: 1 (default) makes the headline the page's h1, as on /gtaverse pages; pass 2 or 3 where the timeline
// is embedded under other headings. Moment titles and their "more" headings sit one and two levels below it.
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Chip from '../ui/Chip.astro';
import Icon from '../ui/Icon.astro';
import Clip from '../Clip.astro';
import type { IconName } from '../ui/icons';
import { moments, years, trackLayout, confidenceLabel, typeLabel } from '../../lib/lore';
import { categoryLabel, findClipLabels } from '../../lib/media';
import { cardImage } from '../../lib/finds';
import { sourceName } from '../../lib/explainers';
import GameChips from '../games/GameChips.astro';
import { gamesOf } from '../../lib/games';

interface Props { selected?: number; syncUrl?: boolean; headline: string; intro: string; titleAsH1?: boolean; headingLevel?: 1 | 2 | 3 }
const { selected = 0, syncUrl = false, headline, intro, titleAsH1 = false, headingLevel = 1 } = Astro.props;
// The headline takes the level it is given (the page's h1 on /gtaverse pages, lower where the timeline is embedded);
// the moment titles and their "more" headings follow one and two levels below it.
const Headline = `h${headingLevel}` as 'h1' | 'h2' | 'h3';
const MomentTitle = `h${headingLevel + 1}` as 'h2' | 'h3' | 'h4';
const MoreTitle = `h${headingLevel + 2}` as 'h3' | 'h4' | 'h5';
const { width, yearX, momentX } = trackLayout();
const conf: Record<string, { variant: 'verified' | 'outline' | 'muted' | 'debunked'; icon: IconName }> = {
  canon: { variant: 'verified', icon: 'check' },
  strong: { variant: 'outline', icon: 'dot' },
  speculative: { variant: 'muted', icon: 'question' },
  debunked: { variant: 'debunked', icon: 'cross' },
};
const usedYears = [...new Set(moments.map((m) => m.year))];
---
<section class="lore" data-lore data-selected={selected} data-sync-url={syncUrl ? 'true' : undefined}>
  <header class="lore__head container">
    <Headline class="lore__headline">{headline}{titleAsH1 && <span class="sr-only" data-headline-title>: {moments[selected].title}</span>}</Headline>
    <div class="lore__side">
      <p class="lore__intro">{intro}</p>
      <slot name="head" />
    </div>
  </header>

  <!-- Desktop: Grok hairline + V7 ticks -->
  <div class="band" data-band>
    <div class="band__arrows">
      <Button variant="outline" size="s" icon="arrow-left" iconOnly label="Previous moment" class="band__arrow" data-step="-1" />
      <Button variant="outline" size="s" icon="arrow-right" iconOnly label="Next moment" class="band__arrow band__arrow--next" data-step="1" />
    </div>
    <div class="band__line" aria-hidden="true"></div>
    <div class="band__viewport" role="group" aria-label="Timeline: use the arrow keys to move between moments" tabindex="0" data-band-viewport>
      <div class="band__track" style={`width: ${width}px; --x: ${momentX[selected]}`} data-track>
        <div class="band__ruler" aria-hidden="true"></div>
        <svg class="band__links" width={width} height="132" viewBox={`0 0 ${width} 132`} aria-hidden="true" focusable="false" data-links></svg>
        {years.map((y) => (
          <span class:list={['band__year', { 'is-empty': !usedYears.includes(y) }]} style={`left: ${yearX[y]}px`} aria-hidden="true"><span class="mono-caps">{y}</span></span>
        ))}
        {moments.map((m) => (
          <button
            type="button"
            class:list={['band__dot', { 'is-selected': m.index === selected }]}
            style={`left: ${momentX[m.index]}px`}
            data-go={m.index}
            tabindex="-1"
            aria-label={`${m.year}, ${m.title}`}
            aria-pressed={m.index === selected ? 'true' : 'false'}
          ><span></span></button>
        ))}
      </div>
      <span class="band__marker" aria-hidden="true"><span></span></span>
    </div>
  </div>

  <!-- Phone: Queue sheet with the year ruler -->
  <div class="sheet">
    <div class="ruler" data-ruler>
      <div class="ruler__scroll" data-ruler-scroll aria-label="Scrub the timeline">
        <div class="ruler__ticks">
          {moments.map((m) => (
            <button type="button" class="ruler__tick" data-go={m.index} data-year={m.year} tabindex="-1" aria-label={`${m.year}, ${m.title}`}><span></span></button>
          ))}
        </div>
      </div>
      <span class="ruler__centre" aria-hidden="true"></span>
      <p class="ruler__years mono" aria-live="polite">
        <span class="ruler__prev" data-year-prev aria-hidden="true">{usedYears[usedYears.indexOf(moments[selected].year) - 1] ?? ''}</span>
        <span class="ruler__now" data-year-now>{moments[selected].year}</span>
        <span class="ruler__next" data-year-next aria-hidden="true">{usedYears[usedYears.indexOf(moments[selected].year) + 1] ?? ''}</span>
      </p>
    </div>

    <div class="panels" data-panels>
      {moments.map((m) => {
        const c = conf[m.confidence] ?? conf.strong;
        const cf = m.clipFind;
        return (
          <article class="moment" data-panel={m.index} data-slug={m.slug} data-title={m.title} data-year={m.year} data-first={m.firstGame} data-games={gamesOf(m.games).map((g) => g.id).join(' ')} hidden={m.index !== selected} aria-labelledby={`moment-${m.slug}`}>
            <p class="moment__date mono-caps">{m.year} · {m.firstGame}</p>
            <MomentTitle class="moment__title" id={`moment-${m.slug}`}>
              {m.title}
            </MomentTitle>
            <p class="moment__desc">{m.summary}</p>
            <div class="moment__badges">
              <Badge variant={c.variant} icon={c.icon} title={`Confidence: ${confidenceLabel[m.confidence] ?? m.confidence}`}>{confidenceLabel[m.confidence] ?? m.confidence}</Badge>
              <Badge variant="meta">{typeLabel[m.type] ?? m.type}</Badge>
            </div>

            <figure class="polaroid" aria-label={cf ? `Clip: ${cf.title}` : undefined}>
              <span class="polaroid__back" aria-hidden="true"></span>
              <div class="polaroid__frame">
                {cf?.clip ? (
                  <Clip clip={cf.clip} title={cf.title} spoiler={cf.spoiler} mature={cf.mature} chapterGate={cf.chapter_gate} caption={false} ratio="16 / 10" />
                ) : (
                  <div class="polaroid__glow" aria-hidden="true"><span>{m.firstGame}</span></div>
                )}
              </div>
            </figure>
            {cf?.clip && (
              <div class="moment__watch">
                <a class="watch" href={`/finds/${cf.slug}#tabs`} data-watch>
                  <span class="watch__icon" aria-hidden="true"><Icon name={findClipLabels(cf).icon} size={12} /></span>
                  {cf.spoiler || cf.mature ? findClipLabels(cf).revealBar : findClipLabels(cf).bar}
                </a>
                <p class="watch__credit">Clip by {cf.clip.creator ?? 'an unknown creator'}, from <a href={`/finds/${cf.slug}`}>{cf.title}</a></p>
              </div>
            )}

            <div class="moment__more">
              <GameChips games={gamesOf(m.games)} label="Also in" level={MoreTitle} class="more" />
              {m.finds.length > 0 && (
                <section class="more">
                  <MoreTitle class="more__title label-caps">See it in GTA VI</MoreTitle>
                  <ul class="more__finds">
                    {m.finds.map((f) => {
                      const img = cardImage(f);
                      return <li><Card href={`/finds/${f.slug}`} image={img?.thumb} kicker={categoryLabel(f)} title={f.title} meta={f.spoiler ? 'Spoiler' : undefined} /></li>;
                    })}
                  </ul>
                </section>
              )}
              <section class="more">
                <MoreTitle class="more__title label-caps">Sources</MoreTitle>
                <ul class="more__sources">
                  {m.sources.map((s) => <li><Chip href={s.url} touch target="_blank" rel="noopener" title={s.title ?? s.url}>{sourceName(s)}</Chip></li>)}
                </ul>
              </section>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<script>
  import { roll } from '../../scripts/motion/roll';
  // The curves are the motion tokens (tokens.css), read once, so the script never keeps a second copy of a value.
  const tokens = getComputedStyle(document.documentElement);
  const ease = { out: tokens.getPropertyValue('--ease-out').trim(), exit: tokens.getPropertyValue('--ease-standard').trim(), inOut: tokens.getPropertyValue('--ease-in-out').trim() };
  document.querySelectorAll<HTMLElement>('[data-lore]').forEach((root) => {
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.band__dot')];
    const ticks = [...root.querySelectorAll<HTMLButtonElement>('.ruler__tick')];
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const viewport = root.querySelector<HTMLElement>('[data-band-viewport]')!;
    const scroller = root.querySelector<HTMLElement>('[data-ruler-scroll]')!;
    const panelsBox = root.querySelector<HTMLElement>('[data-panels]')!;
    const yearPrev = root.querySelector<HTMLElement>('[data-year-prev]')!;
    const yearNow = root.querySelector<HTMLElement>('[data-year-now]')!;
    const yearNext = root.querySelector<HTMLElement>('[data-year-next]')!;
    const years = [...new Set(panels.map((p) => Number(p.dataset.year)))];
    const xs = dots.map((d) => parseFloat(d.style.left));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const phone = matchMedia('(max-width: 767px)');
    let current = Number(root.dataset.selected) || 0;
    let rulerLock = false;
    // The game lens (?game=, components/games/GameLens.astro): only moments listing that game can be selected.
    const all = panels.map((_, i) => i);
    let allowed = all;
    const nextAllowed = (from: number, dir: number) => {
      const list = dir > 0 ? allowed.filter((i) => i > from) : allowed.filter((i) => i < from).reverse();
      return list[0] ?? from;
    };

    // The year on the phone ruler rolls to the new one, digit by digit: later years roll up (motion study item 14).
    const setYears = (i: number, instant = false) => {
      const y = Number(panels[i].dataset.year);
      const k = years.indexOf(y);
      roll(yearNow, String(y), { instant: instant || reduce.matches });
      yearPrev.textContent = years[k - 1] ? String(years[k - 1]) : '';
      yearNext.textContent = years[k + 1] ? String(years[k + 1]) : '';
    };

    const centreRuler = (i: number, smooth: boolean) => {
      const t = ticks[i];
      if (!t) return;
      rulerLock = true;
      const left = t.offsetLeft + t.offsetWidth / 2 - scroller.clientWidth / 2;
      scroller.scrollTo({ left, behavior: smooth ? 'smooth' : 'auto' });
      window.setTimeout(() => { rulerLock = false; }, smooth ? 450 : 50);
    };

    // Links: when a moment shares its first game with others, thin arcs join it to the nearest of them on the band.
    // They are drawn only after the band has stopped moving (stroke-dashoffset, 500ms), and fade as it starts again.
    const links = root.querySelector<SVGSVGElement>('[data-links]')!;
    const ns = 'http://www.w3.org/2000/svg';
    let linkTimer = 0;
    const drawLinks = (i: number, still: boolean) => {
      clearTimeout(linkTimer);
      const old = [...links.children] as SVGElement[];
      old.forEach((p) => p.animate([{ opacity: 1 }, { opacity: 0 }], { duration: still ? 0 : 120, easing: ease.exit, fill: 'forwards' }).finished.then(() => p.remove(), () => p.remove()));
      const first = panels[i].dataset.first;
      const near = allowed
        .filter((k) => k !== i && panels[k].dataset.first === first)
        .sort((a, b) => Math.abs(xs[a] - xs[i]) - Math.abs(xs[b] - xs[i]))
        .slice(0, 5);
      const draw = () => near.forEach((k) => {
        const a = xs[i], b = xs[k];
        const h = Math.min(40, 14 + Math.abs(b - a) * 0.06);
        const path = document.createElementNS(ns, 'path');
        path.setAttribute('d', `M${a} 76 Q${(a + b) / 2} ${76 - h * 2} ${b} 76`);
        path.setAttribute('pathLength', '1');
        links.append(path);
        if (!still) path.animate([{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 500, easing: ease.inOut, fill: 'backwards' });
      });
      if (still) draw(); else linkTimer = window.setTimeout(draw, 500); // the band's move (500ms) lands first
    };

    // instant: keyboard and first paint never animate (design system rule).
    const select = (i: number, { instant = false, fromRuler = false } = {}) => {
      i = Math.max(0, Math.min(panels.length - 1, i));
      if (i === current) return;
      const dir = i > current ? 1 : -1;
      const prev = panels[current];
      const next = panels[i];
      const still = instant || reduce.matches;
      // Interrupt anything in flight; only the newest move plays.
      panels.forEach((p) => p.getAnimations().forEach((a) => a.cancel()));
      panels.forEach((p) => { if (p !== prev && p !== next) { p.hidden = true; p.classList.remove('is-leaving'); } });

      track.classList.toggle('is-instant', instant || reduce.matches);
      // Set on the track itself: a variable on the root would restyle every panel.
      track.style.setProperty('--x', String(xs[i]));
      dots.forEach((d, k) => { d.classList.toggle('is-selected', k === i); d.setAttribute('aria-pressed', String(k === i)); });
      setYears(i, instant);
      if (!fromRuler) centreRuler(i, !still);
      drawLinks(i, still);

      next.hidden = false;
      if (still) {
        prev.hidden = true;
        if (!instant) next.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 160, easing: ease.out });
      } else {
        // The old moment leaves the layout at once (siblings do not wait) and fades the way it is going. It stops
        // moving at 120ms (75% of its fade); only then does the new one start to move in, so the two never slide
        // together; their fades overlap for the last 40ms.
        const shift = phone.matches ? 24 : 12;
        prev.classList.add('is-leaving');
        prev.animate([{ opacity: 1, transform: 'none' }, { opacity: 0.25, transform: `translateX(${-shift * dir}px)`, offset: 0.75 }, { opacity: 0, transform: `translateX(${-shift * dir}px)` }], { duration: 160, easing: ease.exit, fill: 'forwards' })
          .finished.then(() => { prev.hidden = true; prev.classList.remove('is-leaving'); prev.getAnimations().forEach((a) => a.cancel()); }, () => {});
        next.animate([{ opacity: 0, transform: `translateX(${(shift + 4) * dir}px)` }, { opacity: 1, transform: 'none' }], { duration: 280, delay: 120, easing: ease.out, fill: 'backwards' });
        // The polaroid settles into its tilt as the moment arrives; the card behind follows 40ms later, moving less.
        const frame = next.querySelector<HTMLElement>('.polaroid__frame');
        const backCard = next.querySelector<HTMLElement>('.polaroid__back');
        frame?.animate([{ transform: 'translateY(8px) rotate(0deg)' }, { transform: 'rotate(1.5deg)' }], { duration: 320, delay: 120, easing: ease.out, fill: 'backwards' });
        backCard?.animate([{ transform: 'translateY(4px) rotate(0deg)' }, { transform: 'rotate(-2deg)' }], { duration: 320, delay: 160, easing: ease.out, fill: 'backwards' });
      }
      current = i;
      root.dataset.selected = String(i);
      if (root.dataset.syncUrl) {
        history.replaceState(null, '', `/gtaverse/${next.dataset.slug}`);
        document.title = `${next.dataset.title} | The Vice Files`;
        const h = root.querySelector('[data-headline-title]');
        if (h) h.textContent = `: ${next.dataset.title}`;
      }
    };

    // Clicks on dots, ticks and arrows.
    root.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-go], [data-step]');
      if (!el || !root.contains(el)) return;
      if (el.dataset.go !== undefined) { if (allowed.includes(Number(el.dataset.go))) select(Number(el.dataset.go)); }
      else select(nextAllowed(current, Number(el.dataset.step)));
    });

    // A clicked dot takes focus; never let that scroll the clipped band (it would shift the marker).
    viewport.addEventListener('scroll', () => { viewport.scrollLeft = 0; });

    // Keyboard on the band: arrows, Home and End. Instant, no animation.
    viewport.addEventListener('keydown', (e) => {
      const map: Record<string, number> = { ArrowRight: nextAllowed(current, 1), ArrowLeft: nextAllowed(current, -1), Home: allowed[0] ?? 0, End: allowed[allowed.length - 1] ?? 0 };
      if (!(e.key in map)) return;
      e.preventDefault();
      select(map[e.key], { instant: true });
    });

    // "Watch the clip": play (or reveal) the clip in the polaroid instead of leaving the page.
    panelsBox.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>('[data-watch]');
      if (!a) return;
      const fig = a.closest('.moment')?.querySelector<HTMLElement>('.clip');
      const target = fig?.querySelector<HTMLElement>('.clip-reveal') ?? fig?.querySelector<HTMLElement>('.clip-play');
      if (!target) return;
      e.preventDefault();
      target.click();
    });

    // Phone ruler: scrub with native scroll and snap; the centred tick becomes the moment when scrolling settles.
    const centred = () => {
      const mid = scroller.scrollLeft + scroller.clientWidth / 2;
      let best = 0;
      let dist = Infinity;
      ticks.forEach((t, k) => { if (t.hidden) return; const d = Math.abs(t.offsetLeft + t.offsetWidth / 2 - mid); if (d < dist) { dist = d; best = k; } });
      return best;
    };
    let settle = 0;
    scroller.addEventListener('scroll', () => {
      if (rulerLock) return;
      setYears(centred());
      window.clearTimeout(settle);
      settle = window.setTimeout(() => select(centred(), { fromRuler: true }), 140);
    }, { passive: true });

    // Phone: swipe the moment left or right.
    let sx = 0, sy = 0, st = 0, tracking = false;
    panelsBox.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' || !phone.matches) return;
      if ((e.target as HTMLElement).closest('a, button, iframe')) return;
      tracking = true; sx = e.clientX; sy = e.clientY; st = performance.now();
    });
    panelsBox.addEventListener('pointerup', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - sx, dy = e.clientY - sy;
      const v = Math.abs(dx) / (performance.now() - st);
      if (Math.abs(dx) > Math.abs(dy) * 1.4 && (Math.abs(dx) > 56 || v > 0.4)) select(nextAllowed(current, dx < 0 ? 1 : -1));
    });
    panelsBox.addEventListener('pointercancel', () => { tracking = false; });

    const applyLens = (id: string | null) => {
      allowed = id ? all.filter((i) => (panels[i].dataset.games ?? '').split(' ').includes(id)) : all;
      if (!allowed.length) allowed = all;
      dots.forEach((d, k) => { const off = !allowed.includes(k); d.classList.toggle('is-off', off); d.disabled = off; });
      ticks.forEach((t, k) => { t.hidden = !allowed.includes(k); });
      if (!allowed.includes(current)) select(allowed[0], { instant: true });
      centreRuler(current, false);
    };
    document.addEventListener('vf:game-lens', (e) => applyLens((e as CustomEvent<string | null>).detail));
    if (document.documentElement.dataset.gameLens) applyLens(document.documentElement.dataset.gameLens);

    // First paint: centre the ruler on the selected moment, no motion.
    requestAnimationFrame(() => { track.classList.add('is-instant'); centreRuler(current, false); requestAnimationFrame(() => track.classList.remove('is-instant')); });
    setYears(current, true);
    drawLinks(current, true);
  });
</script>

<style>
  .lore { --anchor: max(36vw, 360px); --text-w: 340px; position: relative; }

  /* ---------- Grok head ---------- */
  .lore__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
    column-gap: var(--space-16);
    align-items: start;
    padding-top: calc(var(--island-top) + var(--island-h) + var(--space-16) + var(--space-12));
  }
  .lore__headline { font-size: var(--text-display-m); font-weight: 400; line-height: 1.05; letter-spacing: -0.02em; text-wrap: balance; }
  .lore__side { display: flex; flex-direction: column; gap: var(--space-5); }
  .lore__intro { color: var(--text-1); font-size: var(--text-body); line-height: 1.6; }

  /* ---------- Band ---------- */
  .band { position: relative; margin-top: 168px; }
  .band__viewport {
    position: relative;
    height: 132px;
    overflow: hidden;
    overflow: clip;
    outline-offset: -2px;
    /* The track fades out under the arrow pills and at the right edge. */
    /* The track fades in after the arrow pills, which sit at the gutter. */
    -webkit-mask-image: linear-gradient(to right, transparent 0, transparent calc(var(--page-pad) + 128px), #000 calc(var(--page-pad) + 220px), #000 92%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, transparent calc(var(--page-pad) + 128px), #000 calc(var(--page-pad) + 220px), #000 92%, transparent 100%);
  }
  .band__line { position: absolute; left: 22px; right: 22px; top: 76px; height: 1px; background: var(--border-1); }
  .band__track {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    transform: translateX(calc(var(--anchor) - var(--x) * 1px));
    transition: transform 500ms var(--ease-in-out);
  }
  .band__track.is-instant { transition: none; }
  /* V7 ruler: one 1px tick every 20px, hanging from the line */
  .band__ruler {
    position: absolute;
    left: 0;
    right: 0;
    top: 77px;
    height: 20px;
    background: repeating-linear-gradient(to right, var(--border-1) 0 1px, transparent 1px 20px);
    opacity: 0.8;
  }
  .band__links { position: absolute; top: 0; left: 0; overflow: visible; pointer-events: none; }
  .band__links :global(path) { fill: none; stroke: var(--accent); stroke-width: 1; stroke-dasharray: 1; opacity: 0.7; }
  .band__year { position: absolute; top: 0; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 8px; color: var(--text-3); }
  .band__year::after { content: ''; width: 1px; height: 47px; background: var(--border-1); }
  .band__year.is-empty { opacity: 0.45; }
  .band__dot {
    position: absolute;
    top: 64px;
    width: 24px;
    height: 56px;
    margin-left: -12px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .band__dot span { width: 4px; height: 4px; margin-top: 10px; border-radius: var(--radius-full); background: var(--text-1); transition: transform var(--dur-press) var(--ease-out); }
  /* V7 event tick in the accent, hanging under each dot */
  .band__dot::after { content: ''; width: 1px; height: 20px; margin-top: 1px; background: var(--accent); opacity: 0.85; }
  .band__dot.is-selected span { opacity: 0; }
  .band__dot.is-off { opacity: 0.2; cursor: default; }
  .band__marker {
    position: absolute;
    top: 65px;
    left: calc(var(--anchor) - 11px);
    width: 22px;
    height: 22px;
