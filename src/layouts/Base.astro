---
// The page shell: fonts, theme, header, footer. Every page uses it.
// layout: 'page' (default) puts the slot in the shared container below the floating header;
//         'bare' hands the full width to the page (heroes, the map).
// sub: the NEON sub bar under the island (pages with a hero only).
// Search and sharing (all optional, added for launch SEO; pages that pass none keep working as before):
//   jsonLd       one or more schema.org objects (src/lib/seo.ts), printed as JSON-LD
//   breadcrumbs  the trail to this page, printed as a BreadcrumbList (not drawn; pages draw their own)
//   ogType       'website' (default) or 'article'
//   noindex      keeps this page out of search even after launch (the 404 page)
// Every page gets a canonical URL, Open Graph and Twitter tags, and its own text-only card (src/lib/routes.ts).
// Whether search engines may index anything is one switch: site.indexable in src/lib/site.ts.
import { Font } from 'astro:assets';
import '../styles/base.css';
import Header, { type SubBar } from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { site, absolute } from '../lib/site';
import { normalizePath, routeFor, ogPath } from '../lib/routes';
import { breadcrumbList, type Crumb } from '../lib/seo';
interface Props { title: string; description?: string; layout?: 'page' | 'bare'; sub?: SubBar; jsonLd?: object | object[]; breadcrumbs?: Crumb[]; ogType?: 'website' | 'article'; noindex?: boolean }
const { title, description = 'A fan-made field guide to GTA VI and the Rockstar universe.', layout = 'page', sub, jsonLd, breadcrumbs, ogType = 'website', noindex = false } = Astro.props;
const path = normalizePath(Astro.url.pathname);
const canonical = absolute(path);
const known = Boolean(routeFor(path));
const ogImage = absolute(ogPath(known ? path : '/'));
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
const robots = !site.indexable || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const ld = [...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []), ...(breadcrumbs?.length ? [breadcrumbList(breadcrumbs)] : [])];
// JSON in a script tag: escape "<" so no value can close the tag.
const ldJson = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content={robots} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0d0c1a" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title={`New finds | ${site.name}`} href="/rss.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title}, on a ${site.name} card`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ld.map((o) => <script type="application/ld+json" set:html={ldJson(o)} />)}
    <script is:inline>
      // Theme before first paint: ?theme= (for checks), then the visitor's choice, then the system setting. Dark first.
      (function () {
        var t = 'dark';
        try {
          var q = new URLSearchParams(location.search).get('theme');
          var s = q || localStorage.getItem('vf-theme');
          t = s === 'light' || s === 'dark' ? s : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        } catch (e) {}
        document.documentElement.dataset.theme = t;
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', t === 'light' ? '#f9f5f0' : '#0d0c1a');
      })();
      // Motion before first paint (docs/DESIGN-SYSTEM.md, "Motion"). Hidden start states apply only under html.js,
      // so without JavaScript, in print and in screenshots everything is visible.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        // Back and forward: entrances never replay (a page restored from the back-forward cache keeps its state).
        try { if (performance.getEntriesByType('navigation')[0].type === 'back_forward') d.classList.add('nav-back'); } catch (_) {}
        // Stills fade in once decoded instead of popping in. An image ready by the first frame shows at once.
        var first = true;
        requestAnimationFrame(function () { requestAnimationFrame(function () { first = false; }); });
        var show = function (img) { if (first) img.setAttribute('data-instant', ''); img.setAttribute('data-in', ''); };
        document.addEventListener('load', function (e) {
          var t = e.target;
          if (!t || t.tagName !== 'IMG' || t.hasAttribute('data-in')) return;
          if (first || !t.decode) show(t); else t.decode().then(function () { show(t); }, function () { show(t); });
        }, true);
        document.addEventListener('error', function (e) { var t = e.target; if (t && t.tagName === 'IMG') show(t); }, true);
        // If the motion script never runs, reveal everything that waits for it.
        setTimeout(function () { if (!d.classList.contains('motion')) d.classList.add('rv-off'); }, 2500);
        // Page transitions: a move between game hubs slides from the side of the game chosen (site-motion.ts sets
        // the direction as the old page leaves; this reads it as the new page is revealed).
        addEventListener('pagereveal', function (e) {
          var vt = e.viewTransition;
          var g = null;
          try { g = JSON.parse(sessionStorage.getItem('vf-vt') || 'null'); sessionStorage.removeItem('vf-vt'); } catch (_) {}
          if (vt && vt.types && g && g.to === location.pathname && Date.now() - g.t < 8000) vt.types.add(g.type);
        });
      })();
    </script>
    <Font cssVariable="--font-display-src" preload />
    <Font cssVariable="--font-body-src" preload />
    <Font cssVariable="--font-mono-src" />
    <Font cssVariable="--font-serif-src" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header sub={sub} />
    <main id="main">
      {layout === 'page' ? <div class="container page"><slot /></div> : <slot />}
    </main>
    <Footer />
    <script>
      import { initSiteMotion } from '../scripts/site-motion';
      initSiteMotion();
    </script>
  </body>
</html>
