{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thevicefiles.com/schema/relief.schema.json",
  "title": "Relief",
  "description": "content/relief.json: hand-drawn, approximate relief for the 3D map. Positions are pixels of the official map image. See docs/MAP-3D.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["note", "label", "metres_per_pixel", "vertical_exaggeration", "features"],
  "properties": {
    "note": { "type": "string" },
    "label": { "type": "string", "minLength": 10, "description": "Shown in the 3D view." },
    "metres_per_pixel": { "type": "number", "exclusiveMinimum": 0, "description": "Display assumption only, not a measurement." },
    "vertical_exaggeration": { "type": "number", "minimum": 1, "maximum": 6 },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "points", "height_m", "radius_px", "roughness", "placed", "basis"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 2 },
          "kind": { "enum": ["peak", "ridge", "hills"] },
          "points": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } } },
          "height_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
          "radius_px": { "type": "integer", "minimum": 50, "maximum": 3000 },
          "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
          "placed": { "enum": ["approximate", "checked"], "description": "checked: a person placed it on the printed map." },
          "basis": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
