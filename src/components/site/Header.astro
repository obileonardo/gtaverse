---
// The site header: the NEON island, fixed and centred, always visible.
//   Desktop: hamburger + wordmark on the left, Map and theme on the right. The hamburger opens the Apple Sports
//   style glass popover anchored to the island; the page dims behind it, the header stays in focus.
//   Phone: the same island across the width; the hamburger opens the Peacock style full screen blurred menu with
//   icon rows and a round close button at the bottom. No tab bar.
// Games switcher (decisions GS1 to GS6): on desktop a vertical "Games" rail is the popover's left column, beside the
// site rows; on the phone a "Games" row opens the same element as a bottom sheet (drag, snap, interruptible). Each
// row: the official logo on its plate, the game's name in text, its GTAverse connection count.
// Optional sub bar (NEON "GET TICKETS" row): pass `sub` from a page with a hero; desktop only.
import Icon from '../ui/Icon.astro';
import GamePlate from '../games/GamePlate.astro';
import { nav, isCurrent } from '../../lib/nav';
import { switcherGroups, connectionCount, TRADEMARK_LINE } from '../../lib/games';
export interface SubBar { href: string; label: string; image?: string | null }
interface Props { sub?: SubBar }
const { sub } = Astro.props;
const path = Astro.url.pathname;
---
<header class="site-header" data-header>
  <div class="island-wrap">
    <nav class="island" aria-label="Main">
      <button class="island__btn island__menu" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Menu" data-menu-open>
        <Icon name="menu" size={24} />
      </button>
      <a class="island__mark" href="/" aria-label="The Vice Files, home">The Vice Files</a>
      <div class="island__actions">
        <a class="island__btn" href="/map" aria-label="Map" aria-current={isCurrent(path, '/map') ? 'page' : undefined}>
          <Icon name="map" size={20} solid={isCurrent(path, '/map')} />
        </a>
        <button class="island__btn" type="button" data-theme-toggle aria-label="Switch to light theme">
          <span class="theme-icon theme-icon--sun"><Icon name="sun" size={20} /></span>
          <span class="theme-icon theme-icon--moon"><Icon name="moon" size={20} /></span>
        </button>
      </div>

      <div class="menu" id="site-menu" data-menu hidden>
        <!-- Games: a vertical rail beside the site rows on desktop; on the phone the same element is a bottom sheet
             opened from the "Games" row. Rows are plain links (navigation, not role="menu"). -->
        <div class="games-scrim" data-games-scrim aria-hidden="true" hidden></div>
        <section class="games" id="games-switcher" aria-labelledby="games-title" data-games data-snap="closed">
          <div class="games__handle" data-sheet-handle aria-hidden="true"><span class="games__grabber"></span></div>
          <div class="games__head">
            <h2 class="games__title" id="games-title">Games</h2>
            <a class="games__all" href="/gtaverse/games">All games</a>
            <button class="games__close" type="button" aria-label="Close games" data-games-close><Icon name="close" size={20} /></button>
          </div>
          <div class="games__scroll" data-games-scroll>
            {switcherGroups.map((group) => (
              <div class="games__group">
                <p class="games__glabel" id={`games-g-${group.id}`}>{group.label}</p>
                <ul class="games__list" role="list" aria-labelledby={`games-g-${group.id}`}>
                  {group.games.map((g) => {
                    const href = `/gtaverse/games/${g.id}`;
                    const current = isCurrent(path, href);
                    const n = connectionCount(g.id);
                    return (
                      <li>
                        <a class:list={['games__row', { 'is-current': current }]} href={href} aria-current={current ? 'page' : undefined} data-game-row>
                          <GamePlate game={g} size="rail" class="games__plate" />
                          <span class="games__name">{g.short_name}<sup class="games__count tabular">{n}<span class="sr-only"> {n === 1 ? 'connection' : 'connections'}</span></sup></span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
            <p class="games__tm">{TRADEMARK_LINE} Used only to identify each game.</p>
          </div>
        </section>

        <ul class="menu__list" role="list">
          {nav.map((item) => {
            const current = isCurrent(path, item.href);
            return (
              <li>
                <a class:list={['menu__link', { 'is-current': current }]} href={item.href} aria-current={current ? 'page' : undefined}>
                  <Icon name={item.icon} size={24} solid={current} class="menu__icon" />
                  <span class="menu__label">{item.label}{item.count !== undefined && <sup class="menu__count tabular">({item.count})</sup>}</span>
                </a>
              </li>
            );
          })}
          <li class="menu__games-item">
            <button class="menu__link menu__games" type="button" aria-expanded="false" aria-controls="games-switcher" data-games-open>
              <Icon name="grid" size={24} class="menu__icon" />
              <span class="menu__label">Games<sup class="menu__count tabular">({switcherGroups.reduce((n, gr) => n + gr.games.length, 0)})</sup></span>
            </button>
          </li>
        </ul>
        <button class="menu__close" type="button" aria-label="Close menu" data-menu-close>
          <Icon name="close" size={22} />
        </button>
      </div>
    </nav>

    {sub && (
      <a class="subbar" href={sub.href} data-subbar>
        <span class="subbar__thumb" aria-hidden="true">{sub.image && <img src={sub.image} alt="" width="96" height="54" loading="eager" decoding="async" data-subbar-img />}</span>
        <span class="subbar__label" data-subbar-label>{sub.label}</span>
        <Icon name="arrow-right" size={16} class="subbar__arrow" />
      </a>
    )}
  </div>
  <div class="menu-scrim" data-menu-scrim hidden></div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const openBtn = header.querySelector<HTMLButtonElement>('[data-menu-open]')!;
    const menu = header.querySelector<HTMLElement>('[data-menu]')!;
    const closeBtn = header.querySelector<HTMLButtonElement>('[data-menu-close]')!;
    const scrim = header.querySelector<HTMLElement>('[data-menu-scrim]')!;
    const phone = matchMedia('(max-width: 767px)');
    let closeTimer = 0;

    const open = () => {
      window.clearTimeout(closeTimer);
      menu.hidden = false;
      scrim.hidden = false;
      openBtn.setAttribute('aria-expanded', 'true');
      if (phone.matches) document.documentElement.classList.add('is-locked');
      if (phone.matches) (menu.querySelector<HTMLElement>('.menu__list [aria-current="page"]') ?? menu.querySelector<HTMLElement>('.menu__list a'))?.focus({ preventScroll: true });
      requestAnimationFrame(() => { header.dataset.menu = 'open'; });
    };
    const close = (instant = false, restoreFocus = true) => {
      if (sheetOpen()) closeSheet(true, false);
      header.dataset.menu = instant ? 'instant' : 'closing';
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('is-locked');
      const done = () => { menu.hidden = true; scrim.hidden = true; delete header.dataset.menu; };
      if (instant) done(); else closeTimer = window.setTimeout(done, 180);
      if (restoreFocus) openBtn.focus({ preventScroll: true });
    };
    const isOpen = () => openBtn.getAttribute('aria-expanded') === 'true';
    const island = header.querySelector<HTMLElement>('.island')!;

    // ---------- Games switcher. Desktop: a rail inside the popover. Phone: a bottom sheet over the overlay menu,
    // dragged 1:1, released into a critically damped spring seeded with the finger's speed (the map sheet's
    // physics, docs/DESIGN-SYSTEM.md), snapping to half or full height, and caught again mid-flight.
    const games = header.querySelector<HTMLElement>('[data-games]')!;
    const gamesBtn = header.querySelector<HTMLButtonElement>('[data-games-open]')!;
    const gamesClose = header.querySelector<HTMLButtonElement>('[data-games-close]')!;
    const gamesScrim = header.querySelector<HTMLElement>('[data-games-scrim]')!;
    const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const H = () => window.innerHeight;
    const snaps: Record<string, () => number> = {
      full: () => 56 + (parseFloat(getComputedStyle(games).getPropertyValue('--safe-top')) || 0),
      half: () => Math.round(H() * 0.42),
      closed: () => H(),
    };
    const project = (v: number, rate = 0.998) => ((v / 1000) * rate) / (1 - rate);
    const rubberband = (over: number, dim: number, c = 0.55) => (over * dim * c) / (dim + c * Math.abs(over));
    let y = H();
    let raf = 0;
    let target = 'closed';
    const sheetOpen = () => gamesBtn.getAttribute('aria-expanded') === 'true';
    const write = (v: number) => {
      y = v;
      games.style.transform = `translate3d(0, ${v}px, 0)`;
      // One source of truth: the scrim is exactly as dark as the sheet is open, mid-drag included.
      gamesScrim.style.opacity = String(Math.max(0, Math.min(1, 1 - (v - snaps.half()) / (H() - snaps.half()))));
    };
    const settled = (id: string) => {
      games.dataset.snap = id;
      if (id === 'closed') {
        games.inert = true;
        gamesScrim.hidden = true;
        games.style.visibility = 'hidden';
      }
    };
    const springTo = (id: string, velocity = 0, instant = false) => {
      cancelAnimationFrame(raf);
      target = id;
      games.dataset.snap = id; // the snap it is heading to: below full the whole sheet drags (touch-action none)
      const to = snaps[id]();
      if (instant) { write(to); settled(id); return; }
      if (reduced()) {
        // Reduced motion: a short fade in place of the travel.
        const closing = id === 'closed';
        if (!closing) { write(to); settled(id); }
        games.animate([{ opacity: closing ? 1 : 0 }, { opacity: closing ? 0 : 1 }], { duration: closing ? 140 : 180, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' })
          .finished.then(() => { if (closing && target === 'closed') { write(to); settled(id); } }, () => {});
        return;
      }
      const omega = (2 * Math.PI) / 0.4;
      let x = y, v = velocity, last = performance.now();
      const step = (now: number) => {
        const dt = Math.max(0, Math.min((now - last) / 1000, 1 / 30));
        last = now;
        v += (-omega * omega * (x - to) - 2 * omega * v) * dt;
        x += v * dt;
        if (Math.abs(x - to) < 0.5 && Math.abs(v) < 8) { write(to); settled(id); return; }
        write(x);
        raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };
    const focusables = (box: HTMLElement) =>
      [...box.querySelectorAll<HTMLElement>('a[href], button')].filter((el) => !el.closest('[inert]') && el.offsetParent !== null);
    const openSheet = (instant = false) => {
      if (!phone.matches) return;
      cancelAnimationFrame(raf);
      games.inert = false;
      games.style.visibility = 'visible';
      gamesScrim.hidden = false;
      gamesBtn.setAttribute('aria-expanded', 'true');
      if (target === 'closed' && Math.abs(y - H()) < 1) write(H());
      springTo('half', 0, instant);
      const first = games.querySelector<HTMLElement>('[aria-current="page"]') ?? games.querySelector<HTMLElement>('[data-game-row]');
      first?.focus({ preventScroll: true });
    };
    const closeSheet = (instant = false, restore = true) => {
      if (!sheetOpen()) return;
      gamesBtn.setAttribute('aria-expanded', 'false');
      springTo('closed', 0, instant);
      if (restore) gamesBtn.focus({ preventScroll: true });
    };
    // Desktop: the rail is part of the popover and always usable. Phone: closed until the Games row opens it.
    const layoutGames = () => {
      cancelAnimationFrame(raf);
      if (phone.matches) {
        gamesBtn.setAttribute('aria-expanded', 'false');
        target = 'closed';
        write(H());
        settled('closed');
      } else {
        games.inert = false;
        games.style.transform = '';
        games.style.visibility = '';
        games.dataset.snap = 'rail';
        gamesScrim.hidden = true;
      }
    };
    layoutGames();

    // Keyboard activations never animate (design system). A click counts as keyboard when no pointer made it.
    let keyed = false;
    header.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') keyed = true; });
    header.addEventListener('pointerdown', () => { keyed = false; });
    const fromKeys = (e: MouseEvent) => { const k = e.detail === 0 || keyed; keyed = false; return k; };
    gamesBtn.addEventListener('click', (e) => (sheetOpen() ? closeSheet() : openSheet(fromKeys(e))));
    gamesClose.addEventListener('click', (e) => closeSheet(fromKeys(e)));
    gamesScrim.addEventListener('click', () => closeSheet(false));

    // Drag: the whole sheet below the full snap, only the handle at the full snap (the list scrolls there).
    let drag: { id: number; startY: number; startSheet: number; samples: { t: number; y: number }[]; active: boolean } | null = null;
    let suppressClick = false;
    games.addEventListener('pointerdown', (e) => {
      if (!phone.matches || drag || (e.pointerType === 'mouse' && e.button !== 0)) return;
      if (!sheetOpen() && y >= H() - 1) return; // closed and settled; a closing sheet can still be caught
      const atTop = Math.abs(y - snaps.full()) < 2;
      if (atTop && !(e.target as HTMLElement).closest('[data-sheet-handle]')) return;
      cancelAnimationFrame(raf); // catch it mid-flight, from where it is
      drag = { id: e.pointerId, startY: e.clientY, startSheet: y, samples: [{ t: e.timeStamp, y }], active: false };
    });
    games.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      const dy = e.clientY - drag.startY;
      if (!drag.active) {
        if (Math.abs(dy) < 6) return; // taps stay taps
        drag.active = true;
        games.setPointerCapture(e.pointerId);
        games.classList.add('is-dragging');
      }
      let next = drag.startSheet + dy;
      const top = snaps.full();
      if (next < top) next = top - rubberband(top - next, H());
      write(next);
      drag.samples.push({ t: e.timeStamp, y: next });
      while (drag.samples.length > 2 && e.timeStamp - drag.samples[0].t > 100) drag.samples.shift();
    });
    const endDrag = (e: PointerEvent) => {
      if (!drag || e.pointerId !== drag.id) return;
      const d = drag;
      drag = null;
      games.classList.remove('is-dragging');
      if (!d.active) { springTo(target === 'closed' ? 'half' : target); return; }
      suppressClick = true;
      const a = d.samples[0], b = d.samples[d.samples.length - 1];
      const v = b.t > a.t ? ((b.y - a.y) / (b.t - a.t)) * 1000 : 0;
      const projected = y + project(v);
      const best = (['full', 'half', 'closed'] as const).reduce((m, id) => (Math.abs(snaps[id]() - projected) < Math.abs(snaps[m]() - projected) ? id : m), 'half' as 'full' | 'half' | 'closed');
      if (best === 'closed') { gamesBtn.setAttribute('aria-expanded', 'false'); springTo('closed', v); gamesBtn.focus({ preventScroll: true }); }
      else { gamesBtn.setAttribute('aria-expanded', 'true'); springTo(best, v); }
    };
    games.addEventListener('pointerup', endDrag);
    games.addEventListener('pointercancel', endDrag);
    games.addEventListener('click', (e) => { if (suppressClick) { e.preventDefault(); e.stopPropagation(); suppressClick = false; } }, true);
    addEventListener('resize', () => { if (phone.matches && sheetOpen() && !drag) { cancelAnimationFrame(raf); write(snaps[target]()); } });

    // A page can ask for the switcher ("Switch game" on a game hub).
    document.addEventListener('vf:open-games', () => {
      if (!isOpen()) open();
      if (phone.matches) openSheet();
      else (games.querySelector<HTMLElement>('[aria-current="page"]') ?? games.querySelector<HTMLElement>('[data-game-row]'))?.focus({ preventScroll: true });
    });

    openBtn.addEventListener('click', (e) => {
      if (isOpen()) return close();
      open();
      // Opened from the keyboard: put focus inside the menu (the current page, else the first site row).
      if (fromKeys(e) && !phone.matches) (menu.querySelector<HTMLElement>('.menu__list [aria-current="page"]') ?? menu.querySelector<HTMLElement>('.menu__list a'))?.focus({ preventScroll: true });
    });
    closeBtn.addEventListener('click', () => close());
    scrim.addEventListener('click', () => close(false, false));
    document.addEventListener('click', (e) => {
      if (isOpen() && !phone.matches && !island.contains(e.target as Node)) close(false, false);
    });
    // Desktop: tabbing out of the island closes the popover, so no hidden link keeps focus.
    island.addEventListener('focusout', (e) => {
      if (isOpen() && !phone.matches && e.relatedTarget && !island.contains(e.relatedTarget as Node)) close(true, false);
    });
    // Keyboard closes instantly (keyboard actions do not animate). Escape closes the games sheet first.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sheetOpen()) { closeSheet(true); return; }
      if (e.key === 'Escape' && isOpen()) close(true);
      if (e.key === 'Tab' && isOpen() && phone.matches) {
        const items = focusables(sheetOpen() ? games : menu).filter((el) => sheetOpen() || !games.contains(el));
        if (!items.length) return;
        const first = items[0], last = items[items.length - 1];
        if (!items.includes(document.activeElement as HTMLElement)) { e.preventDefault(); first.focus(); }
        else if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
    phone.addEventListener('change', () => { if (isOpen()) close(true, false); layoutGames(); });

    // Theme toggle: the choice is remembered on this device; without one, the system setting decides.
    const toggle = header.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
    const label = () => {
      const t = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      toggle.setAttribute('aria-label', t === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
    };
    label();
    toggle.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('vf-theme', next); } catch { /* private mode: the choice lasts for this page only */ }
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#f9f5f0' : '#0d0c1a');
      label();
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    pointer-events: none;
    padding-top: calc(var(--island-top) + env(safe-area-inset-top, 0px));
  }
  .island-wrap {
    width: var(--island-w);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--island-gap);
    pointer-events: auto;
  }

  /* The island. Its blur lives on ::before so the phone menu (position: fixed) is not trapped by backdrop-filter. */
  .island {
    position: relative;
    display: flex;
    align-items: center;
    height: var(--island-h);
    padding-inline: 12px;
    color: var(--text-1);
    background: var(--glass-fill);
    border: var(--border-w) solid var(--glass-border);
    border-radius: var(--radius-xs);
    isolation: isolate;
  }
  .island::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: var(--radius-xs);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    z-index: -1;
  }
  .island__btn {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 40px;
    border-radius: var(--radius-full);
    color: var(--text-1);
    transition: transform var(--dur-press) var(--ease-out), background-color var(--dur-colour) var(--ease-colour);
  }
  .island__btn:active { transform: scale(0.94); }
  .island__menu { width: 40px; }
  .island__mark {
    margin-left: 10px;
    font-family: var(--font-display); font-variation-settings: var(--font-display-axes);
    font-weight: 900;
    font-size: 19px;
    line-height: 1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
    padding-block: 12px;
  }
  .island__actions { margin-left: auto; display: flex; align-items: center; }
  @media (hover: hover) and (pointer: fine) {
    .island__btn:hover { background: var(--glass-hover); }
  }

  .theme-icon { display: grid; place-items: center; grid-area: 1 / 1; }
  .theme-icon--moon { display: none; }
  :global([data-theme='light']) .theme-icon--sun { display: none; }
  :global([data-theme='light']) .theme-icon--moon { display: grid; }

  /* Sub bar (desktop only) */
  .subbar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: var(--island-sub-h);
    padding-inline: 8px 16px;
    border-radius: var(--radius-xs);
    background: var(--bg);
    border: var(--border-w) solid var(--border-1);
    color: var(--accent-text);
    transition: opacity var(--dur-colour) var(--ease-colour), transform var(--dur-colour) var(--ease-out);
  }
  .subbar__thumb {
    width: 48px;
    height: 28px;
    border-radius: 2px;
    overflow: hidden;
    background: var(--glow-hero), var(--surface-2);
    flex: none;
  }
  .subbar__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .subbar__label { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; flex: 1; }
  :global(.subbar__arrow) { color: var(--accent-text); transition: transform var(--dur-colour) var(--ease-out); }
  :global([data-theme='light']) .subbar { background: #2f2f2f; border-color: #2f2f2f; color: #ffffff; }
  :global([data-theme='light']) .subbar :global(.subbar__arrow) { color: #ffffff; }
  @media (hover: hover) and (pointer: fine) {
    .subbar:hover :global(.subbar__arrow) { transform: translateX(3px); }
  }
  :global([data-subbar='hidden']) .subbar { opacity: 0; transform: translateY(-6px); pointer-events: none; }

  /* Desktop menu: glass popover from the hamburger (Apple Sports) */
  /* Two columns since the Games rail (decision GS5): the site rows stay under the island, the rail grows to the
     left of them, and the popover shifts right only when the window is too narrow to hold it. */
  .menu {
    --rail-w: 404px;
    --site-w: calc(var(--island-w) - 20px);
    --menu-w: calc(var(--rail-w) + var(--site-w) + 41px);
    --menu-left: max(calc(var(--island-w) - var(--menu-w)), calc(16px - (100vw - var(--island-w)) / 2));
    position: absolute;
    top: calc(100% + 8px);
    left: var(--menu-left);
    width: var(--menu-w);
    display: grid;
    grid-template-columns: var(--rail-w) var(--site-w);
    column-gap: 10px;
    align-items: start;
    padding: 10px;
    border-radius: var(--radius-xl);
    background: var(--glass-fill-strong);
    border: var(--border-w) solid var(--glass-border);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    transform-origin: calc(-1 * var(--menu-left) + 20px) 0;
    opacity: 0;
    transform: scale(0.96);
    transition: opacity var(--dur-popover-out) var(--ease-standard), transform var(--dur-popover-out) var(--ease-standard);
    z-index: 2;
  }
  :global([data-menu='open']) .menu {
    opacity: 1;
    transform: none;
    transition: opacity var(--dur-popover-in) var(--ease-out), transform var(--dur-popover-in) var(--ease-out);
  }
  :global([data-menu='instant']) .menu { transition: none; }
  .menu__list { grid-column: 2; grid-row: 1; display: flex; flex-direction: column; gap: 4px; }
  .menu__games-item, .games-scrim, .games__handle, .games__close { display: none; }

  /* Games rail (desktop): group labels in a left column, rows 36 high, 4 apart, 10 between groups. */
  .games {
    grid-column: 1;
    grid-row: 1;
