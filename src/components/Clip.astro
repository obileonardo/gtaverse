---
// Shows a thumbnail first; the creator's player loads only when tapped (fast, no tracking on load).
// Spoiler clips stay hidden until the visitor chooses to reveal them.
import { youtubeId, type Clip } from '../lib/content';
interface Props { clip: NonNullable<Clip>; title: string; spoiler?: boolean }
const { clip, title, spoiler = false } = Astro.props;
const yt = clip.platform === 'youtube' ? youtubeId(clip.url) : null;
---
<figure class="clip" data-spoiler={spoiler ? 'true' : 'false'}>
  {spoiler && <button type="button" class="clip-reveal">Reveal spoiler clip</button>}
  <div class="clip-body" hidden={spoiler}>
    {yt ? (
      <button type="button" class="clip-play" data-yt={yt} aria-label={`Play clip: ${title}`}>
        <img src={`https://i.ytimg.com/vi/${yt}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" />
      </button>
    ) : (
      <a href={clip.url} rel="noopener">Watch on {clip.platform}</a>
    )}
  </div>
  <figcaption>Clip by {clip.creator ?? 'unknown'} on {clip.platform}. <a href={clip.url} rel="noopener">Original post</a></figcaption>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('.clip').forEach((fig) => {
    fig.querySelector('.clip-reveal')?.addEventListener('click', (e) => {
      (fig.querySelector('.clip-body') as HTMLElement).hidden = false;
      (e.currentTarget as HTMLElement).remove();
    });
    const btn = fig.querySelector<HTMLButtonElement>('.clip-play');
    btn?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1`;
      f.title = btn.getAttribute('aria-label') ?? 'Clip';
      f.allow = 'autoplay; encrypted-media; picture-in-picture';
      f.allowFullscreen = true;
      f.width = '560'; f.height = '315';
      btn.replaceWith(f);
    });
  });
</script>
