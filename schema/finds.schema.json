{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rockstarworld.elvisobi.com/schema/finds.schema.json",
  "title": "Finds",
  "description": "content/finds.json: every GTA VI find shown on the map. Unknown values are null, never guessed.",
  "type": "array",
  "items": { "$ref": "#/$defs/find" },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": "string", "format": "date" },
    "find": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "title", "status", "category", "verification", "spoiler", "mature", "chapter_gate", "area", "region_ids", "location_description", "pin", "summary", "crossover_games", "related_connections", "first_finder", "clip", "sources", "notes", "updated_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "slug": { "$ref": "#/$defs/id", "description": "URL slug. Unique across finds and explainers." },
        "title": { "type": "string", "minLength": 3 },
        "status": { "enum": ["published", "draft"], "description": "Rumors stay draft until a second independent source confirms them." },
        "category": { "$ref": "#/$defs/id", "description": "Id of a category with kind 'find' in content/categories.json." },
        "verification": { "enum": ["multi-source", "single-source", "rumor", "debunked"] },
        "spoiler": { "type": "boolean", "description": "True when the find reveals or depends on story content. Hidden by default on the site." },
        "mature": { "type": "boolean", "description": "True for sexual or otherwise adult content beyond the game's baseline. Age-gated on the site." },
        "chapter_gate": { "type": ["string", "null"], "pattern": "^Chapter [0-9]+$", "description": "Earliest story chapter in which the find is reachable, when a source states it. Null when unknown." },
        "area": { "type": "string", "description": "Location area as reported by sources, free text. Conflicts are stated here, not resolved." },
        "region_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" }, "description": "Ids from content/regions.json named by the area or location text. Empty when no named region applies." },
        "location_description": { "type": "string" },
        "pin": {
          "description": "Null until placed. Pixel position on the official Rockstar Leonida map image (origin top-left).",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } }
            }
          ]
        },
        "summary": { "type": "string", "minLength": 10 },
        "crossover_games": { "type": "array", "items": { "type": "string" } },
        "related_connections": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" }, "description": "Ids from content/connections.json. Must be mirrored in that item's related_finds." },
        "first_finder": {
          "description": "The person who first found it, only when a source names them. Null when unknown.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["handle", "platform", "url"],
              "properties": {
                "handle": { "type": "string", "minLength": 1 },
                "platform": { "enum": ["youtube", "x", "reddit", "tiktok", "instagram", "twitch", "discord", "web"] },
                "url": { "type": ["string", "null"], "format": "uri" }
              }
            }
          ]
        },
        "clip": {
          "description": "Primary embeddable clip. Must be one of this find's sources. Official platform embeds only, never re-hosted.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["platform", "url", "creator", "source_id"],
              "properties": {
                "platform": { "enum": ["youtube", "x", "reddit", "tiktok"] },
                "url": { "type": "string", "format": "uri" },
                "creator": { "type": "string" },
                "source_id": { "$ref": "#/$defs/id" }
              }
            }
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "type", "url", "creator", "published", "embeddable", "fetched"],
            "properties": {
              "source_id": { "$ref": "#/$defs/id", "description": "Id from content/sources.json." },
              "type": { "enum": ["youtube", "x", "reddit", "tiktok", "article", "wiki", "official"] },
              "url": { "type": "string", "format": "uri" },
              "creator": { "type": "string", "minLength": 1 },
              "published": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/date" }] },
              "embeddable": { "type": "boolean" },
              "fetched": { "type": "boolean", "description": "True when the page was actually read during research, false when known only from a citation or search snippet." }
            }
          }
        },
        "notes": { "type": ["string", "null"], "description": "Editor notes: conflicts between sources, credit details, handling cautions." },
        "updated_at": { "$ref": "#/$defs/date" }
      }
    }
  }
}
