{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thevicefiles.com/schema/categories.schema.json",
  "title": "Categories",
  "description": "content/categories.json: find categories and collectible map layers. icon_key and color_token are placeholders resolved by the design system later; never hex values.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "label", "kind", "description", "icon_key", "color_token", "reference_totals"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "label": { "type": "string", "minLength": 2 },
      "kind": { "enum": ["find", "map-layer"] },
      "description": { "type": "string", "minLength": 5 },
      "icon_key": { "type": "string", "pattern": "^icon\\.[a-z-]+\\.[a-z0-9-]+$" },
      "color_token": { "type": "string", "pattern": "^color\\.[a-z-]+\\.[a-z0-9-]+$", "description": "Token name only. Hex, rgb or hsl values are rejected." },
      "reference_totals": {
        "description": "Counts seen on a third-party checklist, for cross-reference only. Never copy their pins.",
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["marked", "total", "source_id", "url", "as_of", "note"],
            "properties": {
              "marked": { "type": "integer", "minimum": 0 },
              "total": { "type": "integer", "minimum": 0 },
              "source_id": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "as_of": { "type": "string", "format": "date" },
              "note": { "type": "string" }
            }
          }
        ]
      }
    }
  }
}
