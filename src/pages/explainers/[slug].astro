---
// An explainer. The Obvious document (Like): title, standfirst and byline over a hairline, a reading column and a
// quiet contents rail on the right. Tables are the Fiverr level system table (Love), the wanted states with level
// badges. Notes are Productboard callouts (Like); sources close the page as chips with a "Last updated"
// line (Like). Citations [n] link to their source chip.
import Base from '../../layouts/Base.astro';
import Badge from '../../components/ui/Badge.astro';
import Chip from '../../components/ui/Chip.astro';
import Icon from '../../components/ui/Icon.astro';
import LevelTable from '../../components/ui/LevelTable.astro';
import { explainers } from '../../lib/content';
import { explainerParts, sourceName, type Explainer } from '../../lib/explainers';
import { formatDate } from '../../lib/finds';

export function getStaticPaths() {
  return explainers.map((e) => ({ params: { slug: e.frontmatter.slug }, props: { e } }));
}
const { e } = Astro.props as { e: Explainer };
const fm = e.frontmatter;
const { standfirst, segments, headings, minutes } = await explainerParts(e);
const updatedRaw = String(fm.updated_at).slice(0, 10);
const updated = formatDate(updatedRaw);
---
<Base title={fm.title} description={standfirst.replace(/<[^>]+>/g, '').slice(0, 160)}>
  <div class="doc">
    <article class="doc__main">
      <header class="doc__head">
        <h1 class="doc__title">{fm.title}</h1>
        {standfirst && <p class="doc__standfirst" set:html={standfirst} />}
        <p class="doc__byline">
          <span class="doc__mark" aria-hidden="true"><Icon name="explainers" size={16} /></span>
          <span class="doc__by">The Vice Files</span>
          <span class="doc__dot" aria-hidden="true">·</span>
          <span>{updated ? <>Updated <time datetime={updatedRaw}>{updated}</time></> : 'Undated'}</span>
          <span class="doc__dot" aria-hidden="true">·</span>
          <span>{minutes} min read</span>
          {fm.status === 'draft' && <Badge variant="muted" icon="question">Draft, under review</Badge>}
          {fm.spoiler && <Badge variant="outline">Spoiler</Badge>}
        </p>
      </header>

      {headings.length > 1 && (
        <nav class="toc" aria-labelledby="toc-title">
          <details class="toc__box" data-toc>
            <summary class="toc__summary"><span id="toc-title" class="toc__title">On this page</span><Icon name="chevron-down" size={16} class="toc__chevron" /></summary>
            <ul class="toc__list" data-rail>
              {headings.map((h) => <li><a href={`#${h.slug}`} data-rail-link={h.slug}>{h.text}</a></li>)}
            </ul>
          </details>
          <script is:inline>
            // Desktop: the contents rail is always open, before first paint. Phone and tablet: a closed disclosure.
            (function () { var d = document.currentScript.previousElementSibling; if (matchMedia('(min-width: 1024px)').matches) d.open = true; })();
          </script>
        </nav>
      )}

      <div class="prose doc__body">
        {segments.map((s) => s.type === 'html'
          ? <Fragment set:html={s.html} />
          : <LevelTable head={s.head} rows={s.rows} footnote={s.footnote} caption={s.caption} class="doc__table" />)}
      </div>

      <footer class="doc__sources" aria-labelledby="sources-title">
        <h2 id="sources-title" class="doc__sources-title">Sources</h2>
        <ol class="doc__chips">
          {fm.sources.map((s, i) => (
            <li id={`source-${i + 1}`}>
              <Chip href={s.url} touch rel="noopener" target="_blank" title={s.title ?? s.url}><span class="schip__n tabular">{i + 1}</span> {sourceName(s)}</Chip>
            </li>
          ))}
        </ol>
        <ol class="doc__source-list">
          {fm.sources.map((s, i) => <li><span class="tabular">{i + 1}.</span> {s.title ?? s.url}</li>)}
        </ol>
        <p class="doc__updated">Last updated {updated ?? updatedRaw}</p>
      </footer>
    </article>

  </div>
</Base>

<script>
  import { initChapter } from '../../lib/chapter';
  initChapter(); // inline "Spoiler:" blocks open by themselves once the visitor's chapter has reached them

  // "On this page": open as a rail on desktop, a disclosure below; follow the window across the breakpoint.
  const toc = document.querySelector<HTMLDetailsElement>('[data-toc]');
  const wide = matchMedia('(min-width: 1024px)');
  wide.addEventListener('change', () => { if (toc) toc.open = wide.matches; });
  // On the phone, choosing a section closes the disclosure so the section is what you see.
  toc?.addEventListener('click', (e) => { if (!wide.matches && (e.target as HTMLElement).closest('a')) toc.open = false; });

  // Contents rail: mark the section being read. Colour only, no motion.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-rail-link]')];
  const targets = links.map((a) => document.getElementById(a.dataset.railLink!)).filter((t): t is HTMLElement => !!t);
  if (targets.length) {
    const visible = new Set<string>();
    const mark = () => {
      const current = targets.find((t) => visible.has(t.id)) ?? null;
      if (!current) return;
      links.forEach((a) => a.toggleAttribute('aria-current', a.dataset.railLink === current.id));
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => (en.isIntersecting ? visible.add(en.target.id) : visible.delete(en.target.id)));
      mark();
    }, { rootMargin: '-15% 0px -60% 0px' });
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  /* Obvious: a 712 reading column and a 200 rail, centred together. The rail ("On this page") sits in the article
     after the head, so on smaller screens it is a disclosure in reading order; on desktop it is lifted into the
     right column and sticks. */
  .doc { position: relative; display: grid; grid-template-columns: minmax(0, 712px) 200px; justify-content: center; column-gap: var(--space-12); }
  .doc__main { min-width: 0; }
  .doc__head { display: flex; flex-direction: column; gap: var(--space-4); padding-bottom: var(--space-8); border-bottom: var(--border-w) solid var(--border-1); }
  .doc__title { font-size: 40px; font-weight: 700; line-height: 1.1; letter-spacing: -0.025em; text-wrap: balance; }
  .doc__standfirst { color: var(--text-2); font-size: 19px; line-height: 1.45; }
  .doc__byline { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin-top: var(--space-4); color: var(--text-3); font-size: var(--text-body-s); }
  .doc__mark { display: grid; place-items: center; width: 24px; height: 24px; border-radius: var(--radius-full); background: var(--accent-tint); color: var(--accent-text); }
  .doc__by { color: var(--text-1); font-weight: 500; }

  .doc__body { padding-top: var(--space-10); font-size: 18px; line-height: 1.65; }
  .doc__body :global(h2) {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    font-size: var(--text-h2);
    font-weight: 700;
    line-height: 1.2;
    scroll-margin-top: calc(var(--island-top) + var(--island-h) + var(--space-6));
  }
  .doc__body :global(p) { margin-bottom: var(--space-5); }
  .doc__body :global(ul) { display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-6); }
  .doc__body :global(ul > li) { position: relative; padding-left: var(--space-6); }
  .doc__body :global(ul > li)::before { content: ''; position: absolute; left: 6px; top: 0.72em; width: 5px; height: 5px; border-radius: var(--radius-full); background: var(--text-3); }
  .doc__body :global(strong) { font-weight: 600; }
  .doc__body :global(.cite) { margin-left: 2px; font-size: 12px; line-height: 0; vertical-align: super; }
  .doc__body :global(.cite a), .doc__standfirst :global(.cite a) {
    display: inline-grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding-inline: 4px;
    border-radius: var(--radius-full);
    background: var(--accent-tint);
    color: var(--accent-text);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  .doc__standfirst :global(.cite) { font-size: 12px; vertical-align: super; line-height: 0; }

  /* Productboard callout */
  .doc__body :global(.callout) {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-m);
    background: var(--accent-tint);
    color: var(--text-1);
    font-size: var(--text-body);
    line-height: 1.6;
  }
  .doc__body :global(.callout .icon) { flex: none; margin-top: 3px; color: var(--accent-text); }
  .doc__body :global(.callout p) { margin: 0; }
  .doc__body :global(.callout strong) { color: var(--accent-text); }

  .doc__body :global(.doc__table) { margin-block: var(--space-6) var(--space-10); font-size: var(--text-body); line-height: 1.4; }

  /* Lightyear sources */
  .doc__sources { margin-top: var(--space-12); display: flex; flex-direction: column; gap: var(--space-4); }
  .doc__sources-title { color: var(--text-3); font-size: var(--text-body-s); font-weight: 400; }
  .doc__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .doc__chips li { scroll-margin-top: calc(var(--island-top) + var(--island-h) + var(--space-10)); }
  .schip__n { display: inline-grid; place-items: center; min-width: 22px; height: 22px; margin-left: -6px; margin-right: 2px; border-radius: var(--radius-full); background: var(--accent-tint); color: var(--accent-text); font-family: var(--font-mono); font-size: 12px; }
  .doc__chips li:target :global(.chip) { border-color: var(--accent); }
  .doc__source-list { display: flex; flex-direction: column; gap: var(--space-1); color: var(--text-3); font-size: var(--text-caption); }
  .doc__updated { padding-top: var(--space-5); border-top: var(--border-w) solid var(--border-1); color: var(--text-2); font-size: var(--text-body-s); }
  @media (hover: hover) and (pointer: fine) {
    .toc__list a:hover { color: var(--text-1); }
  }

  /* On this page: the Obvious contents rail on desktop, a disclosure on smaller screens (one element). */
  .toc { position: absolute; top: 0; bottom: 0; right: max(0px, calc((100% - 960px) / 2)); width: 200px; }
  .toc__box { position: sticky; top: calc(var(--island-top) + var(--island-h) + var(--space-8)); display: flex; flex-direction: column; gap: var(--space-4); padding-top: var(--space-2); }
  .toc__summary { display: flex; align-items: center; justify-content: space-between; list-style: none; cursor: default; }
  .toc__summary::-webkit-details-marker { display: none; }
  .toc__title { color: var(--text-3); font-size: var(--text-label-caps); font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; }
  .toc :global(.toc__chevron) { display: none; color: var(--text-2); transition: transform var(--dur-colour) var(--ease-out); }
  .toc__list { display: flex; flex-direction: column; margin-top: var(--space-4); border-left: var(--border-w) solid var(--border-1); }
  .toc__list a {
    position: relative;
    display: block;
    padding: 6px 0 6px var(--space-4);
    color: var(--text-2);
    font-size: var(--text-body-s);
    line-height: 1.35;
    transition: color var(--dur-colour) var(--ease-colour);
  }
  .toc__list a[aria-current] { color: var(--text-1); }
  .toc__list a[aria-current]::before { content: ''; position: absolute; left: -1px; top: 6px; bottom: 6px; width: 1px; background: var(--accent); }

  @media (max-width: 1023px) {
    .doc { grid-template-columns: minmax(0, 712px); }
    .toc { position: static; width: auto; margin-top: var(--space-6); }
    .toc__box { position: static; display: block; padding: 0; border: var(--border-w) solid var(--border-1); border-radius: var(--radius-m); background: var(--surface-1); }
    .toc__summary { min-height: 48px; padding-inline: var(--space-4); cursor: pointer; }
    .toc__title { color: var(--text-1); }
    .toc :global(.toc__chevron) { display: block; }
    .toc__box[open] :global(.toc__chevron) { transform: rotate(180deg); }
    .toc__list { margin: 0 var(--space-4) var(--space-4); }
    .toc__list a { min-height: 44px; display: flex; align-items: center; }
  }
  @media (max-width: 767px) {
    .doc__title { font-size: 32px; }
    .doc__standfirst { font-size: 18px; }
    .doc__body { font-size: 17px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .toc__list a, .toc :global(.toc__chevron) { transition: none; }
  }
</style>
