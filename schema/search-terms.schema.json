{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thevicefiles.com/schema/search-terms.schema.json",
  "title": "Search terms",
  "description": "content/search-terms.json: our own words people type for a find type, a place or a topic, used by map search. See docs/MAP.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["note", "categories", "regions"],
  "$defs": {
    "terms": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9 ']*$" } }
  },
  "properties": {
    "note": { "type": "string" },
    "topics": { "type": "object", "description": "Topic groups: a query word in a group matches any word of the group (\"cash\" finds \"loot\"). Keys are our own names.", "additionalProperties": { "$ref": "#/$defs/terms" } },
    "categories": { "type": "object", "additionalProperties": { "$ref": "#/$defs/terms" } },
    "regions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/terms" } }
  }
}
