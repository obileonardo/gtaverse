---
// Home chapter 008, Collectible layers (round 2: the owner's HUXLEY 013 Love, three ruled product cards with mono
// edition labels; phone: HUXLEY M016's one card per screen, a Like). The three layers with the most locations on
// our map: a mono label row (LAYER / STUNTS), the layer's coral blip large on the ground (our own drawing, the honest
// picture of a layer), the name in mono caps, two lines of copy with a round arrow that opens the map, and the
// counts (on our map, and of their total where Game Checklists list more). Buy buttons and prices are left out (the
// board's note). Game Checklists are credited wherever their work shows (decision C7).
// Note: /map?layer=<id> needs the map to read `layer` (listed in the map direction); until then it opens the map.
import ChapterHead from './ChapterHead.astro';
import Button from '../ui/Button.astro';
import { type LayerCard } from '../../lib/home';
import { blipSvg } from '../../icons/render';
import { categoryGlyphs } from '../../icons/family';

interface Props { layers: LayerCard[]; total: number; index: number }
const { layers, total, index } = Astro.props;
const top = layers.slice(0, 3);
const credit = top[0];
const short = (label: string) => label.replace(/^Collectible /, '').replace(/ and stores$/, '');
---
<section class="cl" aria-labelledby="cl-label">
  <div class="container">
    <ChapterHead index={index} label="Collectible layers" count={layers.length} id="cl-label" />
    <ul class="cl__cards" role="list" data-reveal>
      {top.map((l) => (
        <li class="cl__card" data-card-tilt>
          <p class="cl__row"><span class="cl__k">Layer</span><span class="cl__slash" aria-hidden="true">/</span><span class="cl__v">{short(l.label)}</span></p>
          <div class="cl__media"><span class="cl__blip" set:html={blipSvg(categoryGlyphs[l.id as keyof typeof categoryGlyphs], { size: 120 })} /></div>
          <h3 class="cl__name">{l.label}</h3>
          <div class="cl__copyrow">
            <p class="cl__copy"><span class="cl__clamp">Locations from {l.source}, transcribed onto our map.</span></p>
            <Button href={`/map?layer=${l.id}`} variant="outline" size="m" icon="arrow-right" iconOnly label={`Show ${l.label.toLowerCase()} on the map`} class="cl__go" />
          </div>
          <p class="cl__row cl__row--meta">
            <span class="cl__k">Locations</span><span class="cl__slash" aria-hidden="true">/</span><span class="cl__v tabular">{l.marked}</span>
            {l.total !== l.marked && <><span class="cl__k cl__of">Of</span><span class="cl__slash" aria-hidden="true">/</span><span class="cl__v tabular">{l.total}</span></>}
          </p>
        </li>
      ))}
    </ul>
    <div class="cl__foot">
      <Button href="/map" variant="quiet" iconEnd="chevron-right">All {layers.length} layers · {total} locations</Button>
      {credit && <p class="cl__credit">Collectible locations: <a href={credit.via} rel="noopener" target="_blank">{credit.source}</a></p>}
    </div>
  </div>
</section>

<style>
  /* HUXLEY 013: three equal columns, 20 apart, a 1px ruled frame with square corners, 560 tall. */
  .cl__cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); margin-top: var(--space-10); }
  .cl__card { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr auto auto auto; min-height: 560px; padding: var(--space-3); border: var(--border-w) solid var(--rule-soft); transition: border-color var(--dur-colour) var(--ease-colour); }
  .cl__row { display: flex; align-items: baseline; gap: var(--space-8); padding: var(--space-1) 0; font-family: var(--font-mono); font-size: var(--text-mono-caps); letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.4; }
  .cl__k { color: var(--text-3); }
  .cl__v { color: var(--text-1); min-width: 0; overflow: hidden; overflow: clip visible; text-overflow: ellipsis; white-space: nowrap; }
  .cl__slash { color: var(--text-3); }
  .cl__of { margin-left: var(--space-4); }
  .cl__media { display: grid; place-items: center; padding-block: var(--space-12); }
  .cl__blip { display: flex; transition: transform var(--dur-card-lift) var(--ease-out); }
  .cl__name { padding: var(--space-3) 0 var(--space-3); border-bottom: var(--border-w) solid var(--rule-soft); font-family: var(--font-mono); font-size: var(--text-title-l); font-weight: 400; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.3; overflow-wrap: anywhere; }
  .cl__copyrow { display: flex; align-items: center; gap: var(--space-4); padding-block: var(--space-3); border-bottom: var(--border-w) solid var(--rule-soft); }
  .cl__copy { flex: 1; min-width: 0; font-family: var(--font-mono); font-size: var(--text-mono-caps); line-height: 17px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-2); }
  .cl__clamp { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  .cl__row--meta { padding-top: var(--space-3); }
  .cl__foot { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-8); }
  .cl__credit { font-size: var(--text-caption); color: var(--text-3); }
  .cl__credit a { color: var(--text-2); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }

  @media (hover: hover) and (pointer: fine) {
    .cl__card:hover { border-color: var(--border-2); }
    /* With the pointer tilt running (card-tilt.ts, LR46) the blip stays put: a card never tilts and lifts at once. */
    .cl__card:not([data-tilt]):hover .cl__blip { transform: translateY(-4px); }
  }

  /* Phone: one card per screen, 84% wide, the next peeking, scrolling sideways with snap. */
  @media (max-width: 767px) {
    .cl__cards {
      display: flex;
      gap: var(--space-3);
      margin-top: var(--space-6);
      margin-inline: calc(-1 * var(--page-pad));
      padding-inline: var(--page-pad);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--page-pad);
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .cl__cards::-webkit-scrollbar { display: none; }
    .cl__card { flex: 0 0 84%; scroll-snap-align: start; min-height: 480px; }
    .cl__foot { flex-direction: column; align-items: flex-start; }
    .cl__foot :global(.btn), .cl__copyrow :global(.cl__go) { --h: var(--ctrl-size); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cl__card, .cl__blip { transition: none; }
  }
</style>

<script>
  // Phase 8 (LR43, LR46): each layer card tilts a little toward a mouse pointer.
  import { initCardTilt } from './card-tilt';
  initCardTilt(document.querySelectorAll<HTMLElement>('.cl [data-card-tilt]'));
</script>
