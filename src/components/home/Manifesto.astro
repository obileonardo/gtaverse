---
// Home chapter 005, Manifesto (round 2: the owner's Justin Jefferson 012 Love). A breath between the media chapters:
// quote marks, three lines of condensed caps in the --text-2 role, two small lines under them, centred in 650px of
// a wide field of air. The words are our own, from the About page's standfirst (owner answer Q2 A: no invented
// quotes): "A fan-made field guide to GTA VI. Every secret we list is shown in the clip of the fan who found it, with
// its sources and an honest label for how sure we are." No grain (a pattern over reading text).
// Motion: on first view the quote's lines (never letters) rise 16px and fade, 70ms apart (--stagger-hero), over
// --dur-reveal on --ease-reveal, once. Reduced motion: one fade. Without JavaScript it simply shows.
// Highlighter (phase 3, LR16; Chime: "black font with the pink background, it follows the scroll"): as the quote
// crosses the screen, a pink band fills in behind its words one by one and each word turns navy on the pink. Native
// scroll drives it (nothing hijacked, both directions). Each word's band is its ::after, a pink box holding a navy copy
// of the word over the real text, revealed left to right with clip-path; the real text is never clipped, so screen
// readers, selection and the clip audit see plain text. Reduced motion and no JavaScript: fully highlighted, still.
import ChapterHead from './ChapterHead.astro';
interface Props { index: number }
const { index } = Astro.props;
const quote = 'Every secret is shown in the clip of the fan who found it';
const small = 'With its sources and an honest label for how sure we are.';
const words = quote.split(' ');
---
<section class="mf" aria-labelledby="mf-label">
  <div class="container">
    <ChapterHead index={index} label="Manifesto" id="mf-label" />
    <figure class="mf__body" data-mf>
      <p class="mf__marks" aria-hidden="true">&ldquo; &rdquo;</p>
      <blockquote class="mf__quote">
        <p><span class="sr-only">{quote}</span><span aria-hidden="true">{words.map((w, i) => <Fragment><span class="mf__w" data-w data-text={w}>{w}</span>{i < words.length - 1 ? ' ' : ''}</Fragment>)}</span></p>
      </blockquote>
      <figcaption class="mf__small">{small}</figcaption>
    </figure>
  </div>
</section>

<script>
  // The highlighter follows the quote through the screen: it starts when the quote's top reaches 85% of the viewport
  // height and is complete when its bottom reaches 45%. Each word fills in turn (--hl from 0 to 1, set on the word
  // itself). It only runs while the quote is near the screen, at most once a frame, and never under reduced motion
  // (CSS then shows every word highlighted).
  function highlight(fig: HTMLElement, words: HTMLElement[]) {
    const quote = fig.querySelector<HTMLElement>('.mf__quote')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const last = words.map(() => -1);
    let near = false, ticking = false;
    const update = () => {
      ticking = false;
      if (reduce.matches) return;
      const r = quote.getBoundingClientRect();
      const vh = innerHeight;
      const p = Math.min(Math.max((vh * 0.85 - r.top) / (vh * 0.4 + r.height), 0), 1);
      words.forEach((w, i) => {
        const hl = Math.round(Math.min(Math.max(p * words.length - i, 0), 1) * 1000) / 1000;
        if (hl !== last[i]) { last[i] = hl; w.style.setProperty('--hl', String(hl)); }
      });
    };
    const request = () => { if (near && !ticking) { ticking = true; requestAnimationFrame(update); } };
    const reset = () => { words.forEach((w, i) => { w.style.removeProperty('--hl'); last[i] = -1; }); if (!reduce.matches) update(); };
    reduce.addEventListener('change', reset);
    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => { near = e.isIntersecting; if (near) request(); else update(); }, { rootMargin: '25% 0px 25% 0px' }).observe(quote);
    } else near = true;
    update();
  }

  // Lines are only known once the words are laid out: group the words by their top edge, give each line its delay,
  // then reveal the whole quote the first time it comes into view.
  document.querySelectorAll<HTMLElement>('[data-mf]').forEach((fig) => {
    const words = [...fig.querySelectorAll<HTMLElement>('[data-w]')];
    const assign = () => {
      let line = -1, top = NaN;
      words.forEach((w) => {
        const t = w.offsetTop;
        if (!(Math.abs(t - top) < 4)) { line++; top = t; }
        w.style.setProperty('--line', String(line));
      });
      fig.style.setProperty('--lines', String(line + 1));
    };
    assign();
    addEventListener('resize', assign);
    highlight(fig, words);
    if (document.documentElement.classList.contains('nav-back') || !('IntersectionObserver' in window)) { fig.dataset.in = 'skip'; return; }
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      assign();
      fig.dataset.in = 'in';
      io.disconnect();
    }, { rootMargin: '0px 0px -20% 0px' });
    io.observe(fig);
  });
</script>

<style>
  .mf__body { display: grid; justify-items: center; text-align: center; padding-block: 120px 40px; }
  .mf__marks {
    font-family: var(--font-display);
    font-variation-settings: var(--font-display-axes);
    font-weight: 900;
    font-size: var(--text-display-l);
    line-height: 0.7;
    height: 0.5em;
    color: var(--text-3);
  }
  .mf__quote { margin-top: var(--space-12); max-width: 880px; }
  .mf__quote p {
    font-family: var(--font-display);
    font-variation-settings: var(--font-display-axes);
    font-weight: 900;
    font-size: var(--text-manifesto);
    line-height: 1.06;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--text-2);
  }
  /* The highlighter (LR16). --hl is 1 (fully highlighted) by default, for reduced motion and pages without JavaScript;
     with JavaScript and motion it starts at 0 and the script moves it. The band is 0.08em wider than the word on each
     side and 0.04em shorter than the line at the top and bottom, so neighbouring lines keep a hairline of ground. */
  .mf__w { display: inline-block; position: relative; --hl: 1; }
  .mf__w::after {
    content: attr(data-text);
    position: absolute;
    inset: 0 -0.08em;
    padding-inline: 0.08em;
    white-space: nowrap;
    color: var(--on-accent);
    background: var(--accent);
    clip-path: inset(0.04em calc((1 - var(--hl)) * 100%) 0.04em 0);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .mf__w { --hl: 0; }
  }
  .mf__small { margin-top: var(--space-12); max-width: var(--measure-short); font-size: var(--text-body); line-height: 25px; color: var(--text-2); text-wrap: balance; }
  .mf__small a { color: var(--text-1); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; white-space: nowrap; }

  @media screen {
    :global(html.js:not(.rv-off)) .mf__body:not([data-in]) :is(.mf__w, .mf__marks, .mf__small) { opacity: 0; }
    :global(html.js:not(.rv-off)) .mf__body:not([data-in]) .mf__w { translate: 0 16px; }
  }
  /* Each line rises with the gaps shrinking a little (the hero's i*70 - i*i*6), the marks first, the small copy last. */
  .mf__body[data-in='in'] .mf__marks { animation: mf-fade var(--dur-reveal-group) var(--ease-reveal) both; }
  .mf__body[data-in='in'] .mf__w { animation: mf-rise var(--dur-reveal) var(--ease-reveal) both; animation-delay: calc(80ms + var(--line, 0) * var(--stagger-hero) - var(--line, 0) * var(--line, 0) * 6ms); }
  .mf__body[data-in='in'] .mf__small { animation: mf-rise var(--dur-reveal-group) var(--ease-reveal) both; animation-delay: calc(160ms + var(--lines, 3) * var(--stagger-hero)); }
  @keyframes mf-rise { from { opacity: 0; translate: 0 16px; } }
  @keyframes mf-fade { from { opacity: 0; } }

  @media (max-width: 767px) {
    .mf__body { padding-block: 72px 16px; }
    .mf__quote { margin-top: var(--space-8); }
    .mf__small { margin-top: var(--space-8); font-size: 15px; line-height: 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js:not(.rv-off)) .mf__body:not([data-in]) .mf__w { translate: none; }
    .mf__body[data-in='in'] :is(.mf__w, .mf__marks, .mf__small) { animation: mf-fade var(--dur-fade-reduced) linear both; animation-delay: 0ms; }
  }
</style>
