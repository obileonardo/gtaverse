---
// The level table (Fiverr "Level system"), the one table style on the site. A sheet on --surface-1, no borders,
// a 30% label column, rows striped full width with square ends, values centred when they are short, a quiet
// footnote under the table. A row label can carry a level badge: the rounded hexagon in a level colour with a
// glyph inside, and the label set in the same colour (in light the label stays ink: the pastels fail as text).
// Phone: the label column keeps its 30%; a long value drops under the short one so nothing scrolls sideways.
// Cells are HTML strings (they come from rendered markdown).
//   <LevelTable head={['State', 'How it looks']} rows={[{ label: 'In Pursuit', badge: { icon: 'star', solid: true, tone: 3 }, cells: ['White stars'] }]} />
import Icon from './Icon.astro';
import type { IconName } from './icons';
export interface LevelRow { label: string; badge?: { icon: IconName; solid?: boolean; tone: 1 | 2 | 3 | 4 | 5 }; cells: string[] }
interface Props { head: string[]; rows: LevelRow[]; caption?: string; footnote?: string; class?: string }
const { head, rows, caption, footnote, class: className } = Astro.props;
const plain = (h: string) => h.replace(/<[^>]+>/g, '').trim();
// A column is "short" (centred, Fiverr values) when every cell in it is 28 characters or fewer.
const short = head.slice(1).map((_, c) => rows.every((r) => plain(r.cells[c] ?? '').length <= 28));
---
<div class:list={['ltable', className]}>
  <table class="ltable__table" role="table">
    {caption && <caption class="sr-only">{caption}</caption>}
    <thead role="rowgroup">
      <tr role="row">
        {head.map((h, i) => <th role="columnheader" scope="col" class:list={[i === 0 ? 'ltable__label' : 'ltable__value', { 'is-short': i > 0 && short[i - 1] }]} set:html={h} />)}
      </tr>
    </thead>
    <tbody role="rowgroup">
      {rows.map((r) => (
        <tr role="row" style={r.badge ? `--tone: var(--level-${r.badge.tone})` : undefined}>
          <th role="rowheader" scope="row" class:list={['ltable__label', { 'has-badge': r.badge }]}>
            {r.badge && (
              <span class="ltable__badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24"><path d="M10.2 1.9a3.6 3.6 0 0 1 3.6 0l6.7 3.9a3.6 3.6 0 0 1 1.8 3.1v6.2a3.6 3.6 0 0 1-1.8 3.1l-6.7 3.9a3.6 3.6 0 0 1-3.6 0l-6.7-3.9a3.6 3.6 0 0 1-1.8-3.1V8.9a3.6 3.6 0 0 1 1.8-3.1z" /></svg>
                <Icon name={r.badge.icon} solid={r.badge.solid} size={13} stroke={2.2} />
              </span>
            )}
            <span class="ltable__name" set:html={r.label} />
          </th>
          {r.cells.map((c, i) => <td role="cell" class:list={['ltable__value', { 'is-short': short[i], 'is-long': !short[i] }]} set:html={c} />)}
        </tr>
      ))}
    </tbody>
  </table>
  {footnote && <p class="ltable__foot" set:html={footnote} />}
</div>

<style>
  .ltable {
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background: var(--surface-1);
    border: var(--border-w) solid var(--border-1);
  }
  .ltable__table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .ltable__table th, .ltable__table td { padding: var(--space-3) var(--space-4); vertical-align: middle; text-align: left; font-weight: 400; }
  .ltable__table thead th { height: 66px; color: var(--text-2); font-size: var(--text-body-s); font-weight: 500; }
  .ltable__label { width: 30%; color: var(--text-1); }
  .ltable__value { color: var(--text-1); }
  .ltable__value.is-short { text-align: center; font-weight: 500; }
  .ltable__value.is-long { color: var(--text-2); font-size: var(--text-body-s); line-height: 1.5; }
  tbody tr:nth-child(odd) { background: rgb(255 255 255 / 0.04); }
  :global([data-theme='light']) .ltable tbody tr:nth-child(odd) { background: #f8f8f8; }

  .has-badge { color: var(--tone, var(--text-1)); font-weight: 500; }
  :global([data-theme='light']) .ltable .has-badge { color: var(--text-1); }
  .ltable__table th.has-badge { padding-left: calc(var(--space-4) + 24px + var(--space-3)); position: relative; }
  .ltable__badge { position: absolute; left: var(--space-4); top: 50%; width: 24px; height: 24px; margin-top: -12px; display: grid; place-items: center; }
  .ltable__badge svg:first-child { position: absolute; inset: 0; fill: var(--tone); }
  .ltable__badge :global(.icon) { position: relative; color: var(--on-accent); }

  .ltable__foot { margin-top: var(--space-8); color: var(--text-3); font-size: var(--text-body-s); }

  @media (max-width: 767px) {
    .ltable { padding: var(--space-4) var(--space-2); border-radius: var(--radius-l); margin-inline: calc(var(--space-2) * -1); }
    .ltable__table, .ltable__table tbody { display: block; }
    .ltable__table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .ltable__table tr { display: grid; grid-template-columns: 30% minmax(0, 1fr); align-items: center; }
    .ltable__table th, .ltable__table td { padding: var(--space-3); }
    .ltable__label { width: auto; grid-row: span 2; align-self: stretch; display: flex; align-items: center; }
    .ltable__table th.has-badge { padding-left: var(--space-3); flex-direction: column; align-items: flex-start; justify-content: center; gap: var(--space-2); }
    .ltable__badge { position: relative; left: auto; top: auto; margin: 0; flex: none; }
    .ltable__value { grid-column: 2; }
    .ltable__value.is-short { text-align: left; padding-bottom: 0; }
    .ltable__value.is-long { padding-top: var(--space-1); }
    .ltable__foot { margin-top: var(--space-6); padding-inline: var(--space-3); }
  }
</style>
