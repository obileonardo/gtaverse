---
// Home 011, How it is made (phase 7e, the Places Love: "Curation team: avatar strip, then Mission, Perspective, Approach").
// Places' "Our curators" block in the site's words: a quiet title, then three headed paragraphs (Places' Mission,
// Perspective, Approach) that are the About page's "How it is made" principles, one inverse button, a hairline, then
// a second group ("Our team / Editorial" in Places): what we cite, with the source totals counted from content, the
// outlets we cite most as link chips and the date the newest change landed (Lightyear's sources and stamp), and the
// editorial policy link. Phone: one column, as drawn. Desktop and tablet: the same blocks in komoot's two columns,
// the method left and the sources right (LR77).
import ChapterHead from './ChapterHead.astro';
import Button from '../ui/Button.astro';
import Chip from '../ui/Chip.astro';
import Icon from '../ui/Icon.astro';
import { finds } from '../../lib/content';
import { outletCredits, creditTotals } from '../../lib/credits';
import { formatDate } from '../../lib/finds';

interface Props { index?: string }
const { index = '012' } = Astro.props;

const count = (t: string) => finds.reduce((n, f) => n + f.sources.filter((s) => s.type === t).length, 0);
const fmt = (n: number) => n.toLocaleString('en-GB');
const videos = count('youtube');
const articles = count('article');
const wikis = count('wiki');
const totals = [{ n: videos, label: 'videos' }, { n: articles, label: 'articles' }, { n: wikis, label: 'wiki pages' }];
const chips = outletCredits.filter((o) => o.url).slice(0, 4);
const updated = finds.map((f) => f.updated_at ?? f.added_at ?? '').sort().at(-1);
const method = [
  { h: 'Sources first', p: 'No source link, no fact. Each find carries a verification level: multi-source, single source, rumour or debunked. Rumours stay off the site until a second independent source shows them.' },
  { h: 'Credit the finder', p: "When a source names who found something first, they are credited by handle with a link to their post. Clips play from the creator's own post." },
  { h: 'Our own words', p: "Summaries are written by us. We never copy another guide's text or another map's pins." },
];
---
<section class="hm" aria-labelledby="hm-title">
  <div class="container">
    <ChapterHead index={index} label="How it is made" heading={false} />
    <div class="hm__cols">
      <div class="hm__method">
        <h2 class="hm__title" id="hm-title">Sources first, credit always.</h2>
        <ul class="hm__items" role="list" data-reveal>
          {method.map((m) => (
            <li>
              <h3 class="hm__h">{m.h}</h3>
              <p class="hm__p">{m.p}</p>
            </li>
          ))}
        </ul>
        <Button href="/finders" variant="inverse" size="m" class="hm__btn">All finders</Button>
      </div>

      <div class="hm__sources">
        <h3 class="hm__title">In the sources</h3>
        <h4 class="hm__h hm__h--sub">What we cite</h4>
        <p class="hm__p">Every find lists the posts, videos and articles it comes from. Across all finds we cite {fmt(creditTotals.outlets)} outlets and {fmt(creditTotals.people)} finders and creators, in these sources:</p>
        <ul class="hm__stats" role="list">
          {totals.map((t) => <li><span class="hm__num">{fmt(t.n)}</span><span class="hm__unit">{t.label}</span></li>)}
        </ul>
        {chips.length > 0 && (
          <div class="hm__chips">
            <p class="hm__label">Cited most</p>
            <ul class="hm__chiplist" role="list">
              {chips.map((o) => <li><Chip href={o.url!} rel="noopener" target="_blank">{o.name}</Chip></li>)}
            </ul>
          </div>
        )}
        {updated && <p class="hm__stamp">Last updated {formatDate(updated)}</p>}
        <a class="hm__link" href="/editorial-policy">Editorial policy <Icon name="chevron-right" size={16} stroke={2} /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .hm { padding-top: var(--space-chapter); }
  /* Desktop and tablet: komoot's two equal columns, 48 apart. */
  .hm__cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-12); margin-top: var(--space-12); }
  .hm__method, .hm__sources { min-width: 0; }
  /* Places' type, relative to its 15pt body: titles 1.27x, headings 1.13x, body at a 1.3 line. */
  .hm__title { font-size: var(--text-title-l); font-weight: 500; line-height: 1.3; color: var(--text-1); }
  .hm__items { display: flex; flex-direction: column; gap: var(--space-6); margin-top: var(--space-6); }
  .hm__h { font-size: var(--text-title); font-weight: 500; line-height: 1.3; color: var(--text-1); }
  .hm__h--sub { margin-top: var(--space-6); }
  .hm__p { margin-top: var(--space-1); max-width: var(--measure); font-size: var(--text-body); line-height: 1.4; color: var(--text-1); }
  .hm__method :global(.hm__btn) { margin-top: var(--space-6); }

  /* Dropbox (Like): the totals as numbers over small captions, formatted, no icons. */
  .hm__stats { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-10); margin-top: var(--space-4); }
  .hm__stats li { display: flex; flex-direction: column; gap: 2px; }
  .hm__num { font-size: var(--text-h1); font-weight: 600; line-height: var(--leading-tight); letter-spacing: -0.01em; font-variant-numeric: tabular-nums; color: var(--text-1); }
  .hm__unit { font-size: var(--text-caption); color: var(--text-2); }
  .hm__chips { margin-top: var(--space-6); }
  .hm__label { font-size: var(--text-caption); color: var(--text-2); }
  .hm__chiplist { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2); }
  .hm__stamp { margin-top: var(--space-6); padding-top: var(--space-4); border-top: var(--border-w) solid var(--border-1); font-size: var(--text-caption); color: var(--text-2); }
  .hm__link { display: inline-flex; align-items: center; gap: 4px; min-height: 44px; margin-top: var(--space-2); font-size: var(--text-body-s); font-weight: 600; color: var(--text-1); }
  .hm__link :global(.icon) { color: var(--text-2); transition: transform var(--dur-colour) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .hm__link:hover :global(.icon) { transform: translateX(3px); }
  }

  /* Phone: Places as drawn, one column; the hairline between the two groups. */
  @media (max-width: 767px) {
    .hm__cols { grid-template-columns: minmax(0, 1fr); gap: 0; margin-top: var(--space-8); }
    .hm__stats { gap: var(--space-4) var(--space-8); }
    .hm__p { font-size: var(--text-body-s); line-height: 1.3; }
    .hm__method :global(.hm__btn) { --h: 44px; }
    .hm__sources { margin-top: var(--space-6); padding-top: var(--space-8); border-top: var(--border-w) solid var(--border-1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hm__link :global(.icon) { transition: none; }
  }
</style>
