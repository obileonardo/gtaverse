---
// Home. The hero (components/home/Hero.astro): a stage of three modes (official trailer reel, official key art, our
// line art) behind the A24 stack of featured finds on desktop and the Apple TV slides on the phone.
// Featured = the first five published finds (content order) that are safe to show and have a still, with titles
// short enough to sit on one line of the A24 stack (47 characters).
// Below the hero, fifteen numbered chapters (round 2 of the taste board, docs/DESIGN-SYSTEM.md "Home chapters"),
// each opened by a 1px rule and a mono index. Media chapters alternate with type-led ones so no two neighbours look
// alike; they are 160px apart (--space-chapter). Every list and number comes from content (src/lib/home.ts), and a
// find shown in an earlier chapter is skipped where a later one would repeat it.
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import AskBar from '../components/home/AskBar.astro';
import Spotlight from '../components/home/Spotlight.astro';
import SelectedFinds from '../components/home/SelectedFinds.astro';
import NewThisWeek from '../components/home/NewThisWeek.astro';
import WatchClips from '../components/home/WatchClips.astro';
import Manifesto from '../components/home/Manifesto.astro';
import ByType from '../components/home/ByType.astro';
import TheMap from '../components/home/TheMap.astro';
import CollectibleLayers from '../components/home/CollectibleLayers.astro';
import Chapter009Numbers from '../components/home/Chapter009Numbers.astro';
import Chapter010Regions from '../components/home/Chapter010Regions.astro';
import Chapter011Made from '../components/home/Chapter011Made.astro';
import Chapter012Finders from '../components/home/Chapter012Finders.astro';
import Chapter013Explainers from '../components/home/Chapter013Explainers.astro';
import Chapter014Leads from '../components/home/Chapter014Leads.astro';
import Chapter015Gtaverse from '../components/home/Chapter015Gtaverse.astro';
import { finds } from '../lib/content';
import { findStill, findClipLabels } from '../lib/media';
import { addedThisWeek } from '../lib/feed';
import { spotlightFinds, selectedFilters, newThisWeek, clipFinds, typeEntries, topRegions, layerCards, collectibleTotal } from '../lib/home';
import { website, organization } from '../lib/seo';

// Finds with a still come first; finds without one still qualify and show the sunrise glow instead.
const safe = finds.filter((f) => !f.spoiler && !f.mature && f.title.length <= 47);
const featured = [...safe.filter((f) => findStill(f)), ...safe.filter((f) => !findStill(f))].slice(0, 5);
const lead = featured[0];
const leadStill = lead ? findStill(lead) : null;

// What 001 to 008 show (src/lib/home.ts); 009 to 015 read their own data.
const spot = spotlightFinds(featured);
const filters = selectedFilters([...featured, ...spot]);
const shownAbove = [...featured, ...spot, ...filters[0].finds];
const fresh = newThisWeek(shownAbove);
const freshTotal = addedThisWeek().length;
const layers = layerCards();
---
<Base
  title="The Vice Files"
  layout="bare"
  jsonLd={[website(), organization()]}
  sub={lead ? { href: `/finds/${lead.slug}?tab=clips#tabs`, label: findClipLabels(lead).bar, image: leadStill?.thumb } : undefined}
>
  <Hero featured={featured} />

  <div class="chapters">
    {/* The search band (LR28): unnumbered, so Spotlight stays 001. */}
    <AskBar />
    <Spotlight index={1} finds={spot} />
    <SelectedFinds index={2} filters={filters} />
    <NewThisWeek index={3} finds={fresh} total={freshTotal} />
    <WatchClips index={4} finds={clipFinds()} />
    <Manifesto index={5} />
    <ByType index={6} types={typeEntries()} />
    <TheMap index={7} regions={topRegions()} />
    <CollectibleLayers index={8} layers={layers} total={collectibleTotal} />
  </div>
  {/* 009 to 015 each open with their own --space-chapter of room above and add nothing below. */}
  <Chapter009Numbers />
  <Chapter010Regions />
  <Chapter012Finders index="011" />
  <Chapter011Made index="012" />
  <Chapter013Explainers />
  <Chapter014Leads />
  <Chapter015Gtaverse />
</Base>

<style>
  /* Chapters sit --space-chapter apart (160, 96 on the phone). */
  .chapters { display: flex; flex-direction: column; gap: var(--space-chapter); padding-top: var(--space-chapter); }
  .chapters > :global(*) { min-width: 0; }
  /* Apple TV on the phone: the first chapter follows the hero's dots closely. */
  @media (max-width: 767px) {
    .chapters { padding-top: var(--space-12); }
  }
</style>
