{
  "name": "the-vice-files",
  "version": "0.1.0",
  "private": true,
  "description": "The Vice Files: an unofficial, non-commercial fan field guide to Grand Theft Auto VI and the Rockstar universe.",
  "type": "module",
  "license": "(MIT AND CC-BY-NC-4.0)",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/validate.mjs && astro build",
    "preview": "astro preview",
    "validate": "node scripts/validate.mjs",
    "test": "node --test scripts/test/*.test.ts",
    "seo:check": "node scripts/check-seo.mjs",
    "deploy": "pnpm map:fetch && pnpm map:tiles && pnpm build && pnpm dlx wrangler@4.159.0 deploy",
    "map:fetch": "node scripts/map/fetch-map.mjs",
    "map:tiles": "node scripts/map/build-tiles.mjs",
    "map:grid": "node scripts/map/measure-grid.mjs",
    "map:harness": "node tools/map-harness/serve.mjs",
    "map:shots": "node tools/map-harness/screenshots.mjs"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "ajv": "^8.20.0",
    "satori": "0.63.2",
    "sharp": "~0.35.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "astro": "7.4.13",
    "leaflet": "1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.187.0"
  }
}
