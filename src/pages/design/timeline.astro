---
// The GTAverse timeline for the design system page (/design), framed on its own page because its phone layout follows
// the width of the window it is in (media queries), and the frame gives it that width. Embedded here, its headline is
// an h2 (headingLevel), not the h1 it is on /gtaverse pages. /design embeds this page in an iframe
// (components/design/Frame.astro).
import Frame from '../../components/design/Frame.astro';
import Timeline from '../../components/lore/Timeline.astro';
---
<Frame title="Timeline">
  <div class="container">
    <Timeline headingLevel={2} headline="The GTAverse" intro="Every connection between the games, on one line. This is the real component with the real moments." />
  </div>
</Frame>

<style is:global>
  /* /design already sets the gutter around the frame, so the container inside it has none. */
  body.ds-frame-body { padding-block: var(--space-8); --page-pad: 0px; }
</style>
