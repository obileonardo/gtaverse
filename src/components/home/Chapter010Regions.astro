---
// Home 010, Regions (board r2: Olha Lazarieva C06, Love). Two staggered panels over a faint giant word.
// Panel A: the selected area's finds as five portrait stills with captions, a numbered pager of the areas with arrows,
// and at the bottom the counter "01/06" left and the area's name right, both in thin caps.
// Panel B (112px lower): a carousel of the same area's finds, the focused still centred with dimmed neighbours,
// the find counter and its title at the bottom.
// Areas: Leonida's counties and regions (the regions whose parent is the state) that hold at least one find that is
// safe to show with a still, most finds first. Finds of an area are its own and its sub-areas'. Spoiler and mature
// finds never show here. A find without a still shows the sunrise glow with its category (Card rule).
import ChapterHead from './ChapterHead.astro';
import Icon from '../ui/Icon.astro';
import { finds, regions, type Find } from '../../lib/content';
import { findStill, categoryLabel } from '../../lib/media';

interface Props { index?: string }
const { index = '010' } = Astro.props;

const byId = new Map(regions.map((r) => [r.id, r]));
const state = regions.find((r) => r.parent === null);
const ancestors = (id: string) => { const out: string[] = []; let r = byId.get(id); while (r) { out.push(r.id); r = r.parent ? byId.get(r.parent) : undefined; } return out; };
const safe = finds.filter((f) => !f.spoiler && !f.mature);
const tops = regions.filter((r) => r.parent === state?.id && (r.type === 'county' || r.type === 'region'));
const areas = tops
  .map((r) => {
    const own = safe.filter((f) => f.region_ids.some((id) => ancestors(id).includes(r.id)));
    const withStill = own.filter((f) => findStill(f));
    return { id: r.id, name: r.name, finds: [...withStill, ...own.filter((f) => !findStill(f))], stills: withStill.length };
  })
  .filter((a) => a.stills > 0)
  .sort((a, b) => b.finds.length - a.finds.length || a.name.localeCompare(b.name));
const pad = (n: number) => String(n).padStart(2, '0');
const tile = (f: Find) => ({ f, still: findStill(f) });
---
<section class="ch10" aria-labelledby="ch10-title" data-ch10>
  <div class="container"><ChapterHead index={index} label="Regions" id="ch10-title" /></div>
  <div class="ch10__stage container">
    <p class="ch10__word" aria-hidden="true" data-ch10-word>{state?.name ?? 'Leonida'}</p>

    <div class="ch10__a">
      <div class="ch10__grids">
        {areas.map((a, ai) => (
          <ul class="ch10__grid" role="list" data-ch10-grid={ai} hidden={ai !== 0} aria-label={`Finds in ${a.name}`}>
            {a.finds.slice(0, 5).map(tile).map(({ f, still }, i) => (
              <li style={`--i: ${i}`}>
                <a class="ch10__tile" href={`/finds/${f.slug}`}>
                  <span class="ch10__still">
                    {still ? <img src={still.thumb} srcset={`${still.thumb} 320w, ${still.src} 1280w`} sizes="(max-width: 767px) 30vw, 120px" alt="" loading="lazy" decoding="async" /> : <span class="ch10__glow"><span>{categoryLabel(f)}</span></span>}
                  </span>
                  <span class="ch10__cap">{f.title}</span>
                  <span class="ch10__sub">{categoryLabel(f)}</span>
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
      <div class="ch10__pager">
        <button type="button" class="ch10__arrow" data-ch10-step="-1" aria-label="Previous area"><Icon name="arrow-left" size={16} /></button>
        <ol class="ch10__nums" role="list">
          {areas.map((a, ai) => (
            <li><button type="button" class:list={['ch10__num', { 'is-active': ai === 0 }]} data-ch10-area={ai} aria-pressed={ai === 0 ? 'true' : 'false'} aria-label={a.name}>{pad(ai + 1)}</button></li>
          ))}
        </ol>
        <button type="button" class="ch10__arrow" data-ch10-step="1" aria-label="Next area"><Icon name="arrow-right" size={16} /></button>
      </div>
      <div class="ch10__foot">
        <p class="ch10__count" aria-hidden="true"><span data-ch10-count>01</span>/{pad(areas.length)}</p>
        <p class="ch10__name" aria-live="polite" data-ch10-name>{areas[0]?.name}</p>
      </div>
    </div>

    <div class="ch10__b">
      {areas.map((a, ai) => (
        <div class="ch10__carousel" data-ch10-car={ai} hidden={ai !== 0}>
          <ul class="ch10__track" role="list" aria-label={`${a.name}: one find at a time`}>
            {a.finds.slice(0, 10).map(tile).map(({ f, still }, i) => (
              <li class="ch10__slide" data-i={i} style={`--o: ${i}`}>
                <a href={`/finds/${f.slug}`} tabindex={i === 0 ? undefined : '-1'} aria-label={f.title}>
                  {still ? <img src={still.src} srcset={`${still.thumb} 320w, ${still.src} 1280w`} sizes="(max-width: 767px) 80vw, 360px" alt="" loading="lazy" decoding="async" /> : <span class="ch10__glow"><span>{categoryLabel(f)}</span></span>}
                </a>
              </li>
            ))}
          </ul>
          <div class="ch10__bfoot">
            <p class="ch10__count ch10__count--b" aria-hidden="true"><span data-ch10-fcount>01</span>/{pad(Math.min(a.finds.length, 10))}</p>
            <p class="ch10__title" data-ch10-ftitle>{a.finds[0]?.title}</p>
          </div>
          <script type="application/json" data-ch10-titles set:html={JSON.stringify(a.finds.slice(0, 10).map((f) => f.title))} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ch10 { padding-top: var(--space-chapter); overflow-x: clip; }
  .ch10__stage { position: relative; display: grid; grid-template-columns: 48fr 4fr 48.5fr; align-items: start; margin-top: var(--space-12); padding-bottom: var(--space-16); }
  /* The faint word: Big Shoulders 100, as wide as the content box, behind both panels (Olha's "GALLERY"). */
  .ch10__word {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    font-family: var(--font-display);
    font-variation-settings: var(--font-display-axes);
    font-weight: 100;
    font-size: clamp(160px, 31vw, 480px);
    line-height: 0.8;
    text-transform: uppercase;
    text-align: center;
    color: var(--text-1);
    opacity: 0.05;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    padding-block: 0.1em;
  }
  .ch10__a, .ch10__b { position: relative; background: var(--surface-1); padding: var(--space-6); min-width: 0; }
  .ch10__a { grid-column: 1; display: flex; flex-direction: column; aspect-ratio: 830 / 460; }
  .ch10__b { grid-column: 3; margin-top: 112px; display: flex; flex-direction: column; container-type: inline-size; overflow: clip visible; }

  .ch10__grids { display: grid; }
  .ch10__grid { grid-area: 1 / 1; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
  .ch10__grid[hidden] { display: none; }
  .ch10__tile { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .ch10__still { display: block; aspect-ratio: 148 / 202; overflow: hidden; background: var(--surface-2); }
  .ch10__still img, .ch10__slide img { width: 100%; height: 100%; object-fit: cover; object-position: center; transition: scale var(--dur-card-lift) var(--ease-out); }
  .ch10__glow { display: grid; place-items: center; width: 100%; height: 100%; background: var(--glow-hero), var(--surface-2); padding: 6px; text-align: center; }
  /* A long label ("REAL-WORLD REFERENCE") ran past a 68px tile at 1024 (LR2): the type follows the tile's width,
     16px at most and never under 12. */
  .ch10__glow { container-type: inline-size; }
  .ch10__glow span { font-family: var(--font-display); font-variation-settings: var(--font-display-axes); font-weight: 900; font-size: clamp(12px, 20cqi, 16px); line-height: 1; text-transform: uppercase; color: var(--text-1); padding-block: 0.15em; }
  .ch10__cap { font-size: var(--text-label-caps); font-weight: 500; text-transform: uppercase; letter-spacing: 0.02em; line-height: 1.35; color: var(--text-1); overflow: clip visible; white-space: nowrap; text-overflow: ellipsis; }
  .ch10__sub { font-size: var(--text-label-caps); line-height: 1.35; text-transform: uppercase; color: var(--text-3); overflow: clip visible; white-space: nowrap; text-overflow: ellipsis; }

  .ch10__pager { display: flex; align-items: center; justify-content: flex-end; gap: 2px; margin-top: auto; }
  .ch10__nums { display: flex; }
  .ch10__num, .ch10__arrow { display: grid; place-items: center; min-width: 32px; height: 44px; font-family: var(--font-mono); font-size: var(--text-mono-caps); color: var(--text-3); transition: color var(--dur-colour) var(--ease-colour); }
  .ch10__num.is-active { color: var(--text-1); }
  .ch10__arrow { color: var(--text-2); width: 44px; }
  .ch10__arrow:active, .ch10__num:active { transform: scale(0.95); }
  @media (hover: hover) and (pointer: fine) {
    .ch10__num:hover, .ch10__arrow:hover { color: var(--text-1); }
    .ch10__tile:hover img, .ch10__slide.is-on a:hover img { scale: 1.03; }
  }
  .ch10__foot, .ch10__bfoot { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-4); }
  .ch10__count, .ch10__name, .ch10__title {
    font-weight: 200;
    font-size: clamp(28px, 2.8vw, 40px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
    padding-block: 0.08em;
  }
  .ch10__count { flex: none; }
  .ch10__name, .ch10__title { text-align: right; color: var(--text-2); text-wrap: balance; min-width: 0; }
  .ch10__title { font-size: clamp(22px, 2.2vw, 32px); line-height: 1.25; padding-block: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  /* Rolling counters: room above and below each digit cell, so the clip never touches a glyph. */
  .ch10 :global(.roll__cell) { padding-block: 0.2em; margin-block: -0.2em; }

  /* Panel B: the focused still centred, two dimmed neighbours either side (Olha's carousel). */
  .ch10__carousel { display: flex; flex-direction: column; flex: 1; min-height: 0; }
  .ch10__carousel[hidden] { display: none; }
  .ch10__track { position: relative; height: 44cqi; margin-block: var(--space-8) var(--space-8); }
  .ch10__slide {
    position: absolute;
    left: 50%;
    top: 0;
    height: 100%;
    aspect-ratio: 285 / 300;
    translate: calc(-50% + var(--x, 0%)) 0;
    scale: 1;
    opacity: 1;
    clip-path: inset(0);
    transition: translate 500ms var(--ease-in-out), scale 500ms var(--ease-in-out), clip-path 500ms var(--ease-in-out), opacity 500ms var(--ease-colour);
  }
  .ch10__slide a { display: block; width: 100%; height: 100%; overflow: hidden; }
  .ch10__slide:not(.is-on) { scale: 0.52; opacity: 0.35; clip-path: inset(0 19%); }
  .ch10__slide.is-far { opacity: 0.2; }
  /* The neighbours show only their middle (the inset above), which would cut a placeholder's label mid-word:
     their labels fade out, and the focused slide's label fades in once it is whole. */
  .ch10__slide .ch10__glow span { transition: opacity 200ms var(--ease-colour) 300ms; }
  .ch10__slide:not(.is-on) .ch10__glow span { opacity: 0; transition-delay: 0ms; transition-duration: 140ms; }
  .ch10__slide.is-gone { opacity: 0; pointer-events: none; }

  /* First view: panel A's tiles rise with a short stagger once (non-uniform, capped at five). */
  :global(html.js) .ch10:not([data-fv-in]) .ch10__grid:not([hidden]) li { opacity: 0; }
  .ch10[data-fv-in='in'] .ch10__grid li { animation: ch10-rise var(--dur-reveal-group) var(--ease-reveal) calc(var(--i) * 40ms - var(--i) * var(--i) * 3ms) both; }
  .ch10 .ch10__grid.is-swap li { animation: ch10-in 280ms var(--ease-out) calc(var(--i) * 30ms) both; }
  @keyframes ch10-rise { from { opacity: 0; translate: 0 12px; } }
  @keyframes ch10-in { from { opacity: 0; } }

  @media (max-width: 1023px) {
    .ch10__stage { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
    .ch10__a, .ch10__b { grid-column: 1; aspect-ratio: auto; }
    .ch10__b { margin-top: 0; }
    .ch10__a { gap: var(--space-4); }
    .ch10__track { height: 300px; }
    /* right 0.1em: the tight line box (0.8) is narrower than the glyphs, so at the edge their ink was cut. */
    .ch10__word { writing-mode: vertical-rl; left: auto; right: 0.1em; top: 0; bottom: auto; font-size: 160px; text-align: start; }
  }
  @media (max-width: 767px) {
    .ch10__a, .ch10__b { padding: var(--space-4); }
    .ch10__a { flex-direction: column-reverse; }
    .ch10__foot { order: 0; }
    .ch10__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: var(--space-4); }
    .ch10__pager { justify-content: space-between; }
    .ch10__track { height: 240px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ch10__slide { transition: opacity var(--dur-fade-reduced) var(--ease-colour); }
    .ch10[data-fv-in='in'] .ch10__grid li, .ch10 .ch10__grid.is-swap li { animation: ch10-in var(--dur-fade-reduced) var(--ease-colour) both; }
    .ch10__still img, .ch10__slide img { transition: none; }
  }
</style>

<script>
  import { roll, rollInit } from '../../scripts/motion/roll';
  import { onFirstView, reduceMotion } from './first-view';

  const pad = (n: number) => String(n).padStart(2, '0');
  for (const root of document.querySelectorAll<HTMLElement>('[data-ch10]')) {
    const grids = [...root.querySelectorAll<HTMLElement>('[data-ch10-grid]')];
    const cars = [...root.querySelectorAll<HTMLElement>('[data-ch10-car]')];
    const nums = [...root.querySelectorAll<HTMLButtonElement>('[data-ch10-area]')];
    const count = root.querySelector<HTMLElement>('[data-ch10-count]')!;
    const name = root.querySelector<HTMLElement>('[data-ch10-name]')!;
    const names = nums.map((n) => n.getAttribute('aria-label') ?? '');
    rollInit(count, '01');
    let area = 0;

    onFirstView([root], (el) => { el.dataset.fvIn = 'in'; }, (el) => { el.dataset.fvIn = 'skip'; });

    // Panel B: place every slide by its distance from the focused one.
    const place = (car: HTMLElement, focus: number, instant = false) => {
      const slides = [...car.querySelectorAll<HTMLElement>('.ch10__slide')];
      slides.forEach((s, i) => {
        const d = i - focus;
        if (instant) s.style.transition = 'none';
        const far = [0, 66, 102, 130][Math.min(Math.abs(d), 3)];
        s.style.setProperty('--x', `${Math.sign(d) * far}%`);
        s.classList.toggle('is-on', d === 0);
        s.classList.toggle('is-far', Math.abs(d) === 2);
        s.classList.toggle('is-gone', Math.abs(d) > 2);
        s.querySelector('a')!.tabIndex = d === 0 ? 0 : -1;
        if (instant) { s.offsetWidth; s.style.transition = ''; }
      });
      car.dataset.focus = String(focus);
      const titles: string[] = JSON.parse(car.querySelector('[data-ch10-titles]')!.textContent || '[]');
      const fc = car.querySelector<HTMLElement>('[data-ch10-fcount]')!;
      if (!fc.dataset.value) rollInit(fc, '01');
      roll(fc, pad(focus + 1), { instant });
      car.querySelector<HTMLElement>('[data-ch10-ftitle]')!.textContent = titles[focus] ?? '';
    };
    // Panel B opens on the third find when there are enough, so neighbours show on both sides (Olha's 03/10).
    const startOf = (c: HTMLElement) => Math.min(2, c.querySelectorAll('.ch10__slide').length - 1);
    cars.forEach((c) => place(c, startOf(c), true));
    cars.forEach((car) => {
      // A dimmed neighbour is the "previous / next" control; the focused one opens the find.
      car.addEventListener('click', (e) => {
        const slide = (e.target as HTMLElement).closest<HTMLElement>('.ch10__slide');
        if (!slide || slide.classList.contains('is-on')) return;
        e.preventDefault();
        place(car, Number(slide.dataset.i), e.detail === 0);
      });
      // Swipe on touch: a horizontal flick past 40px moves one find.
      let x0 = 0, y0 = 0;
      car.addEventListener('pointerdown', (e) => { x0 = e.clientX; y0 = e.clientY; }, { passive: true });
      car.addEventListener('pointerup', (e) => {
        const dx = e.clientX - x0, dy = e.clientY - y0;
        if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
        const n = car.querySelectorAll('.ch10__slide').length;
        const f = Math.min(Math.max(Number(car.dataset.focus) + (dx < 0 ? 1 : -1), 0), n - 1);
        place(car, f);
      });
      car.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        const n = car.querySelectorAll('.ch10__slide').length;
        const f = Math.min(Math.max(Number(car.dataset.focus) + (e.key === 'ArrowRight' ? 1 : -1), 0), n - 1);
        place(car, f, true);
        car.querySelector<HTMLElement>('.ch10__slide.is-on a')?.focus();
        e.preventDefault();
      });
    });

    const select = (i: number, byKey = false) => {
      i = (i + grids.length) % grids.length;
      if (i === area) return;
      const dir = i > area ? 1 : -1;
      area = i;
      grids.forEach((g, k) => { g.hidden = k !== i; g.classList.toggle('is-swap', k === i && !byKey); });
      cars.forEach((c, k) => {
        c.hidden = k !== i;
        if (k === i) { place(c, startOf(c), true); if (!byKey && !reduceMotion()) c.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 240, easing: 'cubic-bezier(0.455, 0.03, 0.515, 0.955)' }); }
      });
      nums.forEach((n, k) => { n.classList.toggle('is-active', k === i); n.setAttribute('aria-pressed', String(k === i)); });
      roll(count, pad(i + 1), { dir, instant: byKey });
      name.textContent = names[i];
    };
    nums.forEach((n, i) => n.addEventListener('click', (e) => select(i, e.detail === 0)));
    root.querySelectorAll<HTMLButtonElement>('[data-ch10-step]').forEach((b) => b.addEventListener('click', (e) => select(area + Number(b.dataset.ch10Step), e.detail === 0)));

    // The faint word drifts at a tenth of the scroll speed on desktop only (transform, no layout).
    const word = root.querySelector<HTMLElement>('[data-ch10-word]')!;
    const wide = matchMedia('(min-width: 1024px)');
    let ticking = false;
    const drift = () => {
      ticking = false;
      if (!wide.matches || reduceMotion()) { word.style.transform = ''; return; }
      const r = root.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return;
      word.style.transform = `translate3d(0, ${((r.top + r.height / 2 - innerHeight / 2) * -0.1).toFixed(1)}px, 0)`;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(drift); } }, { passive: true });
    drift();
  }
</script>
