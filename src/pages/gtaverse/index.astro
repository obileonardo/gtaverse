---
// The GTAverse (the lore section): the shared universe across GTA I to VI, Red Dead, Bully and L.A. Noire, as one
// timeline (Grok on desktop, Queue on the phone), then every connection as a numbered list by year (Brink chapter
// list, Like) so each one is a link without JavaScript. Was /lore; /lore redirects here (public/_redirects).
// ?game=<id> narrows both to one game (the game lens); the games index and hubs live at /gtaverse/games.
import Base from '../../layouts/Base.astro';
import Timeline from '../../components/lore/Timeline.astro';
import ConnectionList from '../../components/lore/ConnectionList.astro';
import GameLens from '../../components/games/GameLens.astro';
import { moments } from '../../lib/lore';
---
<Base title="The GTAverse" description="The shared universe across GTA I to VI, Red Dead, Bully and L.A. Noire: every link to GTA VI, placed on one timeline." layout="bare">
  <Timeline
    headline="The GTAverse"
    intro={`${moments.length} links between GTA VI and the rest of the Rockstar universe. Each sits at the release year of the earliest game it appears in, with how sure we are and where it comes from.`}
  >
    <div slot="head" class="head-links">
      <GameLens noun="connections" />
      <a class="games-link" href="/gtaverse/games">Browse by game</a>
    </div>
  </Timeline>
  <ConnectionList items={moments} title="All connections" />
</Base>

<style>
  .head-links { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  .games-link { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent-text); font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
</style>
