---
// Badges and tags: small, non interactive labels.
// variant:
//   meta      filled grey rectangle (Disney+ badge row): type, region, game
//   verified  pink sticker fill with a pink edge (corner badge): the multi-source verification state
//   outline   1px outline (Apple TV rating badge, NEON "IN THEATERS"): single-source and neutral tags
//   muted     quiet fill with a dashed edge: rumour
//   debunked  quiet fill, label struck through: debunked
//   new       inverse tag with caps (Hulu NEW): white in dark, ink in light (--badge-new-*)
// Verification never relies on colour alone: each state carries its own icon.
import Icon from './Icon.astro';
import type { IconName } from './icons';
interface Props { variant?: 'meta' | 'verified' | 'outline' | 'muted' | 'debunked' | 'new'; icon?: IconName; caps?: boolean; class?: string; title?: string }
const { variant = 'meta', icon, caps = true, class: className, title } = Astro.props;
---
<span class:list={['badge', `badge--${variant}`, { 'badge--caps': caps }, className]} title={title}>
  {icon && <Icon name={icon} size={14} stroke={2} />}
  <span class="badge__label"><slot /></span>
</span>
