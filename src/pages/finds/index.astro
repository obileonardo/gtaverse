---
// Every find. The Disney+ related grid as the whole page: 16:9 cards, five columns on desktop, two on the phone
// (Disney+ iOS), under the site's filter chips. Filtering is instant (used often, no motion).
// ?game=<id> narrows the grid to finds that touch one game (the game lens). Spoiler finds gated to a chapter show
// their art once the visitor's "I'm on Chapter N" setting has reached that chapter.
import Base from '../../layouts/Base.astro';
import Card from '../../components/ui/Card.astro';
import Chip from '../../components/ui/Chip.astro';
import { finds, categories } from '../../lib/content';
import { categoryLabel, regionLabel } from '../../lib/media';
import { cardImage, verificationLabel } from '../../lib/finds';
import { findStill } from '../../lib/media';
import { gameIdsOfFind } from '../../lib/games';
import ChapterControl from '../../components/ChapterControl.astro';
import GameLens from '../../components/games/GameLens.astro';

const used = categories.filter((c) => finds.some((f) => f.category === c.id));
const count = (id: string) => finds.filter((f) => f.category === id).length;
const spoilers = finds.filter((f) => f.spoiler).length;
---
<Base title="All finds" description={`${finds.length} secrets found in GTA VI, each shown in the clip of the fan who found it.`}>
  <header class="head">
    <h1 class="head__title">Finds<sup class="head__count mono">{finds.length}</sup></h1>
    <p class="head__lede">Every secret in Leonida we can show you, each with the clip of the creator who found it. {spoilers} are spoilers: their art stays hidden until you open them, or until your chapter reaches them.</p>
    <ChapterControl />
    <GameLens noun="finds" />
  </header>

  <div class="filters" role="toolbar" aria-label="Filter by category" data-filters>
    <Chip touch selected count={finds.length} data-filter="all">All</Chip>
    {used.map((c) => <Chip touch count={count(c.id)} data-filter={c.id}>{c.label}</Chip>)}
  </div>
  <p class="sr-only" aria-live="polite" data-filter-status></p>

  <ul class="grid" data-grid>
    {finds.map((f, i) => {
      const img = cardImage(f);
      const late = !img && f.spoiler && !f.mature && f.chapter_gate ? findStill(f) : null;
      return (
        <li data-category={f.category} data-lens-games={gameIdsOfFind(f).join(' ')}>
          <Card
            href={`/finds/${f.slug}`}
            image={img?.src}
            srcset={img?.srcset}
            sizes="(max-width: 767px) 50vw, 20vw"
            loading={i < 10 ? 'eager' : 'lazy'}
            kicker={categoryLabel(f)}
            title={f.title}
            meta={`${regionLabel(f)} · ${verificationLabel[f.verification] ?? f.verification}${f.spoiler ? ' · Spoiler' : ''}${f.mature ? ' · Mature' : ''}`}
          >
            {late && <img slot="media" class="card-late" data-chapter-src={late.thumb} data-chapter-gate={f.chapter_gate} alt="" width="320" height="180" loading="lazy" decoding="async" hidden />}
          </Card>
        </li>
      );
    })}
  </ul>
</Base>

<script>
  import { initChapter } from '../../lib/chapter';
  initChapter();
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-grid] > li')];
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  bar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!btn) return;
    const id = btn.dataset.filter!;
    bar.querySelectorAll('[data-filter]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b === btn));
      b.classList.toggle('is-selected', b === btn);
    });
    let shown = 0;
    for (const li of items) {
      const on = id === 'all' || li.dataset.category === id;
      li.hidden = !on;
      if (on && !li.hasAttribute('data-lens-off')) shown++;
    }
    if (status) status.textContent = `${shown} finds shown`;
  });
</script>

<style>
  .head { display: flex; flex-direction: column; gap: var(--space-4); max-width: 820px; }
  .head__title {
    font-family: var(--font-display);
    font-variation-settings: var(--font-display-axes);
    font-weight: 900;
    font-size: var(--text-display-l);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }
  .head__count { margin-left: 6px; vertical-align: top; position: relative; top: 0.3em; font-size: var(--text-mono); font-weight: 400; color: var(--text-2); }
  .head__lede { max-width: var(--measure-short); color: var(--text-2); }
  .grid :global(.card-late) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .filters {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-10);
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .filters > :global(*) { flex: none; }

  .grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 28px var(--space-5); margin-top: var(--space-8); }
  .grid > li[hidden] { display: none; }

  @media (min-width: 768px) and (max-width: 1199px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .filters { margin-top: var(--space-8); margin-inline: calc(var(--page-pad) * -1); padding-inline: var(--page-pad); }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6) var(--space-3); margin-top: var(--space-6); }
  }
</style>
